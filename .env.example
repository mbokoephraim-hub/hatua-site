# Copiez ce fichier en `.env` puis complétez les valeurs.

# Service d'envoi du formulaire de contact : "formspree" (par défaut) ou "netlify"
PUBLIC_FORM_PROVIDER=formspree

# [À COMPLÉTER] Identifiant Formspree (la partie après /f/ dans https://formspree.io/f/xxxxxxx)
PUBLIC_FORMSPREE_ID=

# URL publique du site (sans barre finale)
SITE_URL=https://hatua-foundation.org

# Sous-dossier pour GitHub Pages sans domaine personnalisé (ex. /hatua-site). Laisser vide sinon.
BASE_PATH=
