---
/** En-tête des pages intérieures, avec le motif « marches ». */
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  /** Ambiance de couleur (charte) : miel, baobab, terre ou ivoire */
  tone?: 'miel' | 'baobab' | 'terre' | 'ivoire';
}
const { eyebrow, title, intro, tone = 'miel' } = Astro.props;
---

<section class={`tone-${tone} page-hero-blobs hero-immersive relative overflow-hidden`} data-hero>
  <svg class="ph-stairs pointer-events-none absolute right-0 bottom-0 h-full max-h-64 w-auto text-heading opacity-10" viewBox="0 0 400 260" data-parallax="0.18" aria-hidden="true">
    <rect fill="currentColor" x="0" y="210" width="101" height="50" style="--i:0" />
    <rect fill="currentColor" x="100" y="150" width="101" height="110" style="--i:1" />
    <rect fill="currentColor" x="200" y="90" width="101" height="170" style="--i:2" />
    <rect fill="currentColor" x="300" y="30" width="100" height="230" style="--i:3" />
  </svg>
  <div class="container-site hero-text relative py-14 sm:py-20">
    <p class="eyebrow">
      <span class="step-line" aria-hidden="true"><span></span><span></span><span></span></span>
      {eyebrow}
    </p>
    <h1 class="mt-4 max-w-3xl text-4xl font-bold sm:text-5xl">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{intro}</p>}
    <slot />
  </div>
</section>
