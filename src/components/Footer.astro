---
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { footerNav } from '../data/navigation';
import { site } from '../data/site';
import { t } from '../i18n/ui';
import { url } from '../utils/url';
---

<footer class="relative overflow-hidden bg-primary-dark text-white/85">
  <!-- Motif « marches » discret -->
  <svg class="pointer-events-none absolute -right-10 bottom-0 h-56 w-auto text-white/[0.04]" viewBox="0 0 400 220" aria-hidden="true">
    <path fill="currentColor" d="M0 220V170h80v-50h80V70h80V20h80V0h80v220z" />
  </svg>

  <div class="container-site relative grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.2fr]">
    <div class="max-w-sm">
      <a href={url('/')} aria-label={`${site.name}, accueil`}>
        <img src={url('/logo-light.svg')} alt="" width="172" height="48" class="h-11 w-auto" loading="lazy" />
      </a>
      <p class="mt-5 leading-relaxed">{site.shortMission}</p>
      <p class="mt-4 font-display text-sm font-semibold uppercase tracking-[0.14em] text-accent-soft">{site.slogan}</p>
    </div>

    <div>
      <h2 class="font-display text-base font-semibold text-white">{t('footer.quickLinks')}</h2>
      <ul class="mt-4 space-y-2.5">
        {
          footerNav.map((item) => (
            <li>
              <a href={url(item.href)} class="hover:text-accent-soft hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-base font-semibold text-white">{t('footer.contact')}</h2>
      <ul class="mt-4 space-y-3">
        <li class="flex items-start gap-3">
          <Icon name="mail" size={20} class="mt-0.5 shrink-0 text-accent-soft" />
          <a href={`mailto:${site.contact.email}`} class="break-all hover:text-accent-soft hover:underline">{site.contact.email}</a>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone" size={20} class="mt-0.5 shrink-0 text-accent-soft" />
          <a href={site.contact.phoneHref} class="hover:text-accent-soft hover:underline">{site.contact.phoneDisplay}</a>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="map-pin" size={20} class="mt-0.5 shrink-0 text-accent-soft" />
          <span>{site.location.city}, {site.location.countryShort}</span>
        </li>
      </ul>
      <h2 class="mt-7 font-display text-base font-semibold text-white">{t('footer.follow')}</h2>
      <div class="mt-3"><SocialLinks variant="light" /></div>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="container-site flex flex-col gap-2 py-6 text-sm text-white/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© {site.copyrightYear} {site.name}. {t('footer.rights')}</p>
      <p>{site.status} · {site.location.city}, {site.location.countryShort}</p>
    </div>
  </div>
</footer>
