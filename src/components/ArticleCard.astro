---
/** Carte d'un article dans la liste (et en « à lire aussi »). */
import Icon from './Icon.astro';
import { articleLang, articleSlug, formatDate, readingTime, type Article } from '../data/articles';
import { articlePath, getLang } from '../i18n';
import { url } from '../utils/url';

interface Props {
  article: Article;
  featured?: boolean;
}
const { article, featured = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const { title, description, date, image, imageAlt, tags, draft } = article.data;
const href = articlePath(articleSlug(article), lang);
const minutes = readingTime(article);
const statsKey = `${articleLang(article)}/${articleSlug(article)}`;
const T = { fr: { read: 'Lire l’article', min: 'min de lecture', draft: 'Brouillon', view: 'vue', views: 'vues' }, en: { read: 'Read the article', min: 'min read', draft: 'Draft', view: 'view', views: 'views' } }[lang];
---

<article class:list={['card card-hover group reveal flex h-full flex-col overflow-hidden !p-0', featured && 'md:grid md:grid-cols-2']}>
  <a href={href} class="relative block aspect-[16/10] overflow-hidden bg-sand md:aspect-auto" tabindex="-1" aria-hidden="true">
    {
      image ? (
        <img
          src={url(image)}
          alt=""
          width="1200"
          height="750"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] md:absolute md:inset-0"
        />
      ) : (
        <span class="flex h-full min-h-48 w-full items-center justify-center bg-primary-50 text-primary">
          <Icon name="book" size={48} />
        </span>
      )
    }
  </a>
  <div class:list={['flex flex-1 flex-col p-6', featured && 'sm:p-9']}>
    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
      {draft && <span class="rounded-full bg-secondary px-3 py-1 text-white">{T.draft}</span>}
      {tags.slice(0, 2).map((tag) => <span class="rounded-full bg-primary-50 px-3 py-1 text-primary">{tag}</span>)}
    </div>
    <h3 class:list={['mt-4 font-semibold leading-snug', featured ? 'text-2xl sm:text-3xl' : 'text-xl']}>
      <a href={href} class="hover:underline">{title}</a>
    </h3>
    <p class="mt-3 flex-1 leading-relaxed text-muted">{description}</p>
    <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
      <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={15} /> {minutes} {T.min}</span>
      <span class="hidden items-center gap-1.5" data-views-for={statsKey} data-one={T.view} data-label={T.views}><Icon name="eye" size={15} /> <span data-n></span></span>
    </p>
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary" aria-hidden="true">
      {T.read} <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</article>

<script>
  // Nombre de vues sur les cartes et le catalogue (un seul appel pour toute la page)
  const tags = [...document.querySelectorAll<HTMLElement>('[data-views-for]')];
  const keys = [...new Set(tags.map((t) => t.dataset.viewsFor!))];
  if (keys.length) {
    fetch(`/api/stats.php?slugs=${keys.map(encodeURIComponent).join(',')}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d) return;
        const fmt = new Intl.NumberFormat(document.documentElement.lang === 'en' ? 'en-GB' : 'fr-FR');
        for (const t of tags) {
          const s = d[t.dataset.viewsFor!];
          if (!s) continue;
          t.querySelector('[data-n]')!.textContent = `${fmt.format(s.views)} ${s.views > 1 ? t.dataset.label : t.dataset.one}`;
          t.classList.remove('hidden');
          t.classList.add('inline-flex');
        }
      })
      .catch(() => undefined);
  }
</script>
