---
/**
 * Carte d'un article (liste « À la une » et « À lire aussi »).
 * Toute la carte est cliquable (lien étiré sur le titre) et un vrai bouton « Lire l'article » invite à la lecture.
 */
import Icon from './Icon.astro';
import { articleLang, articleSlug, formatDate, readingTime, type Article } from '../data/articles';
import { articlePath, getLang } from '../i18n';
import { url } from '../utils/url';

interface Props {
  article: Article;
  featured?: boolean;
}
const { article, featured = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const { title, description, date, image, tags, draft, author, authorImage, authorLink } = article.data;
const href = articlePath(articleSlug(article), lang);
const minutes = readingTime(article);
const statsKey = `${articleLang(article)}/${articleSlug(article)}`;
const avatar = authorImage ?? (authorLink === 'founder' ? '/images/fondatrice-640.webp' : null);
const T = {
  fr: { read: 'Lire l’article', min: 'min', draft: 'Brouillon', view: 'vue', views: 'vues', featured: 'À la une', by: 'Par' },
  en: { read: 'Read the article', min: 'min', draft: 'Draft', view: 'view', views: 'views', featured: 'Featured', by: 'By' },
}[lang];
// Couleurs des étiquettes, dans l'ordre
const tagTones = ['bg-primary-50 text-primary', 'bg-secondary-50 text-secondary', 'bg-accent/70 text-encre'];
---

<article
  class:list={[
    'article-card group reveal relative flex h-full flex-col overflow-hidden rounded-3xl bg-white ring-1 ring-sand transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:ring-hibiscus/60',
    featured ? 'shadow-lg md:grid md:grid-cols-[1.1fr_1fr]' : 'shadow-sm',
  ]}
>
  <div class:list={['relative overflow-hidden bg-sand', featured ? 'aspect-[16/10] md:aspect-auto md:min-h-[26rem]' : 'aspect-[16/10]']}>
    {
      image ? (
        <img
          src={url(image)}
          alt=""
          width="1200"
          height="750"
          loading={featured ? 'eager' : 'lazy'}
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      ) : (
        <span class="absolute inset-0 flex items-center justify-center bg-primary-50 text-primary">
          <Icon name="book" size={48} />
        </span>
      )
    }
    <span class="pointer-events-none absolute inset-0 bg-linear-to-t from-encre/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></span>
    {
      featured && (
        <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-hibiscus px-3.5 py-1.5 text-xs font-bold tracking-wide text-encre uppercase shadow-md">
          <Icon name="sparkles" size={14} /> {T.featured}
        </span>
      )
    }
    <span class="absolute right-4 bottom-4 inline-flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-encre backdrop-blur">
      <Icon name="clock" size={13} /> {minutes} {T.min}
    </span>
  </div>

  <div class:list={['flex flex-1 flex-col', featured ? 'p-6 sm:p-9 lg:p-10' : 'p-5 sm:p-6']}>
    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
      {draft && <span class="rounded-full bg-secondary px-3 py-1 text-white">{T.draft}</span>}
      {tags.slice(0, 3).map((tag, i) => <span class:list={['rounded-full px-3 py-1', tagTones[i % tagTones.length]]}>{tag}</span>)}
    </div>
    <h3 class:list={['mt-4 font-bold tracking-tight text-balance text-secondary', featured ? 'text-2xl leading-tight sm:text-4xl' : 'text-xl leading-snug']}>
      <a href={href} class="after:absolute after:inset-0 after:z-10 focus-visible:outline-none">{title}</a>
    </h3>
    <p class:list={['mt-3 flex-1 leading-relaxed text-muted', featured ? 'text-base sm:text-lg' : 'line-clamp-3 text-[0.95rem]']}>{description}</p>

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
      {
        avatar && (
          <span class="inline-flex items-center gap-2">
            <img src={url(avatar)} alt="" width="32" height="32" loading="lazy" class="h-8 w-8 rounded-full object-cover ring-2 ring-hibiscus/60" />
            <span><span class="sr-only">{T.by} </span><strong class="font-semibold text-ink">{author}</strong></span>
          </span>
        )
      }
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
      <span class="hidden items-center gap-1.5" data-views-for={statsKey} data-one={T.view} data-label={T.views}><Icon name="eye" size={15} /> <span data-n></span></span>
    </div>

    <span
      class:list={[
        'mt-6 inline-flex w-fit items-center gap-2 rounded-full font-semibold transition',
        featured
          ? 'bg-secondary px-6 py-3 text-white shadow-md group-hover:bg-secondary-dark group-hover:shadow-lg'
          : 'bg-secondary-50 px-4 py-2 text-sm text-secondary group-hover:bg-secondary group-hover:text-white',
      ]}
      aria-hidden="true"
    >
      {T.read} <Icon name="arrow-right" size={featured ? 18 : 16} class="transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</article>

<style>
  /* Le focus clavier du lien étiré entoure toute la carte */
  .article-card:has(a:focus-visible) {
    outline: 3px solid var(--tone-focus, #5c1a16);
    outline-offset: 3px;
  }
</style>

<script>
  // Nombre de vues sur les cartes et le catalogue (un seul appel pour toute la page)
  const tags = [...document.querySelectorAll<HTMLElement>('[data-views-for]')];
  const keys = [...new Set(tags.map((t) => t.dataset.viewsFor!))];
  if (keys.length) {
    fetch(`/api/stats.php?slugs=${keys.map(encodeURIComponent).join(',')}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d) return;
        const fmt = new Intl.NumberFormat(document.documentElement.lang === 'en' ? 'en-GB' : 'fr-FR');
        for (const t of tags) {
          const s = d[t.dataset.viewsFor!];
          if (!s) continue;
          t.querySelector('[data-n]')!.textContent = `${fmt.format(s.views)} ${s.views > 1 ? t.dataset.label : t.dataset.one}`;
          t.classList.remove('hidden');
          t.classList.add('inline-flex');
        }
      })
      .catch(() => undefined);
  }
</script>
