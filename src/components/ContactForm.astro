---
/**
 * Formulaire de contact sans backend, envoyé via Formspree.
 * L'identifiant du formulaire se règle dans src/data/site.ts (form.formspreeId).
 */
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLang } from '../i18n';
import { useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const tr = useT(lang);

const { formspreeId } = site.form;
const configured = Boolean(formspreeId);
const action = configured ? `https://formspree.io/f/${formspreeId}` : undefined;

const subjects = tr('contactForm.subjects').split('|');

const field =
  'mt-2 block w-full rounded-xl border border-sand bg-white px-4 py-3 text-ink shadow-sm transition placeholder:text-muted/70 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none';
---

<form
  name="contact"
  method="POST"
  action={action}
  data-contact-form
  data-msg-success={tr('contactForm.success')}
  data-msg-error={tr('form.error', { email: site.contact.email })}
  class="card !p-6 sm:!p-8"
  novalidate
>
  <input type="hidden" name="_subject" value={tr('contactForm.mailSubject')} />

  <!-- Champ piège anti-spam : invisible pour les humains -->
  <p class="hidden" aria-hidden="true">
    <label>{tr('form.honeypot')} <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </p>

  {
    !configured && (
      <div class="placeholder-note mb-6 text-sm" role="note">
        <strong>[À COMPLÉTER]</strong> Le formulaire n’est pas encore relié à un service d’envoi. En attendant, écrivez-nous
        directement à <a class="font-semibold text-secondary-dark underline" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
      </div>
    )
  }

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class="font-medium">{tr('contactForm.name')} <span class="text-secondary" aria-hidden="true">*</span></label>
      <input id="cf-name" name="nom" type="text" autocomplete="name" required class={field} />
    </div>
    <div>
      <label for="cf-email" class="font-medium">{tr('contactForm.email')} <span class="text-secondary" aria-hidden="true">*</span></label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required class={field} />
    </div>
  </div>

  <div class="mt-5">
    <label for="cf-subject" class="font-medium">{tr('contactForm.subject')} <span class="text-secondary" aria-hidden="true">*</span></label>
    <select id="cf-subject" name="objet" required class={field}>
      <option value="">{tr('contactForm.chooseSubject')}</option>
      {subjects.map((s) => <option value={s}>{s}</option>)}
    </select>
  </div>

  <div class="mt-5">
    <label for="cf-message" class="font-medium">{tr('contactForm.message')} <span class="text-secondary" aria-hidden="true">*</span></label>
    <textarea id="cf-message" name="message" rows="6" required class={field}></textarea>
  </div>

  <p class="mt-4 text-sm text-muted"><span class="text-secondary" aria-hidden="true">*</span> {tr('form.required')}</p>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary disabled:cursor-not-allowed disabled:opacity-60" disabled={!configured}>
      {tr('contactForm.send')} <Icon name="send" size={18} />
    </button>
  </div>

  <p class="mt-5 hidden rounded-xl p-4 font-medium" role="status" aria-live="polite" data-form-status></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');

  const show = (msg: string, ok: boolean) => {
    if (!status) return;
    status.textContent = msg;
    status.classList.remove('hidden', 'bg-primary-50', 'text-primary-dark', 'bg-secondary-50', 'text-secondary-dark');
    status.classList.add(...(ok ? ['bg-primary-50', 'text-primary-dark'] : ['bg-secondary-50', 'text-secondary-dark']));
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    const data = new FormData(form);

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show(form.dataset.msgSuccess ?? '', true);
    } catch {
      show(form.dataset.msgError ?? '', false);
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
