---
/**
 * Visuel du hero : les quatre verbes de la mission, en marches qui montent — en relief.
 * Les marches respirent, un petit marcheur grimpe de marche en marche (étincelles en haut),
 * l'escalier suit la souris et, au défilement, la « caméra » monte l'escalier (voir src/scripts/immersion.ts).
 */
import { getContent } from '../data';
import { getLang } from '../i18n';
const { site } = getContent(getLang(Astro.currentLocale));
const heights = [38, 56, 74, 92];
const tones = ['st-baobab-soft', 'st-miel', 'st-terre', 'st-baobab'];
---

<div class="stairs" data-stairs aria-hidden="true">
  <div class="stairs-stage">
    <span class="stairs-floor"></span>
    <svg class="stairs-path" viewBox="0 0 400 320" preserveAspectRatio="none" fill="none">
      <path d="M20 230 L120 175 L220 115 L320 55 L385 20" stroke="var(--color-accent)" stroke-width="3" stroke-dasharray="2 12" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="stairs-row">
      {
        site.steps.map((step, i) => (
          <div class={`stair ${tones[i]}`} style={`--i:${i};--h:${heights[i]}%`}>
            <span class="stair-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="stair-label">{step}</span>
          </div>
        ))
      }
    </div>
    <span class="climber"><span class="climber-body"></span></span>
    <span class="stairs-burst">{[0, 1, 2, 3, 4, 5, 6, 7].map((k) => <i style={`--k:${k}`}></i>)}</span>
  </div>
</div>
