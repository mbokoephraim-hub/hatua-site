---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import { getContent } from '../data';
import { getLang, projectPath, quote } from '../i18n';
import { t } from '../i18n/ui';
import { url } from '../utils/url';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const lang = getLang(Astro.currentLocale);
const pole = getContent(lang).poles.find((p) => p.id === project.pole);
---

<article class="card reveal group grid overflow-hidden !p-0 md:grid-cols-2">
  <div class="relative aspect-[3/2] md:aspect-auto">
    <img
      src={url(project.image.src)}
      srcset={project.image.srcSmall ? `${url(project.image.srcSmall)} 800w, ${url(project.image.src)} 1536w` : undefined}
      sizes="(min-width: 768px) 50vw, 100vw"
      alt={project.image.alt}
      width="1536"
      height="1024"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </div>
  <div class="flex flex-col p-7 sm:p-9">
    <div class="flex flex-wrap gap-2 text-xs font-semibold">
      {pole && <span class="rounded-full bg-primary-50 px-3 py-1 text-primary">{pole.englishName}</span>}
      <span class="rounded-full bg-secondary-50 px-3 py-1 text-secondary-dark">{project.status}</span>
    </div>
    <h3 class="mt-4 text-3xl font-bold">{project.title}</h3>
    <p class="mt-1 font-display text-lg font-medium text-secondary">{quote(project.tagline, lang)}</p>
    <p class="mt-4 flex-1 leading-relaxed text-muted">{project.summary}</p>
    <p class="mt-4 flex items-center gap-2 text-sm text-muted">
      <Icon name="map-pin" size={16} class="text-primary" />{project.location}
    </p>
    <a href={projectPath(project.slug, lang)} class="btn btn-green mt-6 self-start">
      {t('project.discover', lang)} <span class="sr-only">{project.title}</span>
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</article>
