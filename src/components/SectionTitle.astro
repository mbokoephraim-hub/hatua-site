---
interface Props {
  eyebrow?: string;
  number?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  id?: string;
}
const { eyebrow, number, title, intro, align = 'left', id } = Astro.props;
---

<div class:list={['reveal max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {
    (eyebrow || number) && (
      <p class:list={['eyebrow', align === 'center' && 'justify-center']}>
        {number && <span class="tabular-nums">{number}</span>}
        <span class="step-line" aria-hidden="true"><span /><span /><span /></span>
        {eyebrow && <span>{eyebrow}</span>}
      </p>
    )
  }
  <h2 id={id} class="mt-4 text-3xl font-bold sm:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-lg leading-relaxed text-muted">{intro}</p>}
  <slot />
</div>
