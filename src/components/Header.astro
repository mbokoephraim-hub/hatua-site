---
/**
 * En-tête : menu en « pilule » sur ordinateur (une icône et une couleur par rubrique),
 * panneau plein écran aux couleurs HATUA sur téléphone.
 */
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { mainNav } from '../data/navigation';
import { site } from '../data/site';
import { getLang, path as routePath, type PageRef } from '../i18n';
import { useT } from '../i18n/ui';
import { url } from '../utils/url';

interface Props {
  page: PageRef;
}
const { page } = Astro.props;
const lang = getLang(Astro.currentLocale);
const tr = useT(lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string, isHome: boolean) => {
  const target = href.replace(/\/$/, '') || '/';
  return isHome ? current === target : current === target || current.startsWith(`${target}/`);
};
const nav = mainNav.map((item) => ({ ...item, href: routePath(item.key, lang), isHome: item.key === 'home' }));
const supportHref = routePath('engageDonate', lang);
---

<header class="site-header" data-header>
  <div class="container-site sh-bar">
    <a href={routePath('home', lang)} class="sh-logo" aria-label={`${site.name}, ${tr('home.aria')}`}>
      <img src={url('/logo.png')} alt="" width="538" height="128" class="sh-logo-dark" />
      <img src={url('/logo-light.png')} alt="" width="538" height="128" class="sh-logo-light" />
    </a>

    <nav aria-label={tr('nav.label')} class="sh-nav">
      <ul>
        {
          nav.slice(1).map((item) => {
            const active = isActive(item.href, item.isHome);
            return (
              <li>
                <a href={item.href} aria-current={active ? 'page' : undefined} class={`nav-${item.color}`}>
                  <span class="sh-ico"><Icon name={item.icon} size={16} /></span>
                  {tr(item.label)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="sh-right">
      <LangSwitch lang={lang} page={page} compact class="sm:hidden" />
      <LangSwitch lang={lang} page={page} class="hidden sm:block" />
      <a href={supportHref} class="sh-cta"><Icon name="heart" size={16} /> {tr('cta.support')}</a>
      <button type="button" class="sh-burger" aria-controls="menu-mobile" aria-expanded="false" data-menu-toggle>
        <span class="sr-only" data-menu-label data-open={tr('nav.open')} data-close={tr('nav.close')}>{tr('nav.open')}</span>
        <span class="sh-lines" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div id="menu-mobile" class="sh-sheet" data-menu hidden>
    <div class="sh-sheet-blob b1" aria-hidden="true"></div>
    <div class="sh-sheet-blob b2" aria-hidden="true"></div>
    <nav aria-label={tr('nav.label')} class="sh-sheet-inner">
      <ul class="sh-list">
        {
          nav.map((item, i) => {
            const active = isActive(item.href, item.isHome);
            return (
              <li style={`--i:${i}`}>
                <a href={item.href} aria-current={active ? 'page' : undefined} class={`nav-${item.color}`}>
                  <span class="sh-tile"><Icon name={item.icon} size={22} /></span>
                  <span class="grow">{tr(item.label)}</span>
                  <Icon name="arrow-right" size={18} class="sh-arrow" />
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="sh-sheet-foot" style={`--i:${nav.length}`}>
        <div class="sh-lang"><span>{tr('lang.label')}</span><LangSwitch lang={lang} page={page} /></div>
        <a href={supportHref} class="sh-cta sh-cta-big"><Icon name="heart" size={18} /> {tr('cta.support')}</a>
        <a href={site.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="sh-wa"><Icon name="whatsapp" size={18} /> WhatsApp</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  // L'en-tête s'affine quand on fait défiler la page
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
      if (label) label.textContent = (open ? label.dataset.close : label.dataset.open) ?? '';
      if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 1280px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
