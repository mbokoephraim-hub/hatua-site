---
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { mainNav } from '../data/navigation';
import { site } from '../data/site';
import { getLang, path as routePath, type PageRef } from '../i18n';
import { useT } from '../i18n/ui';
import { url } from '../utils/url';

interface Props {
  page: PageRef;
}
const { page } = Astro.props;
const lang = getLang(Astro.currentLocale);
const tr = useT(lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string, isHome: boolean) => {
  const target = href.replace(/\/$/, '') || '/';
  return isHome ? current === target : current === target || current.startsWith(`${target}/`);
};
const nav = mainNav.map((item) => ({ ...item, href: routePath(item.key, lang), isHome: item.key === 'home' }));
const supportHref = routePath('engage', lang, 'don');
---

<header class="sticky top-0 z-50 border-b border-sand/80 bg-cream/90 backdrop-blur supports-[backdrop-filter]:bg-cream/80">
  <div class="container-site flex h-[4.5rem] items-center justify-between gap-3 sm:gap-6">
    <a href={routePath('home', lang)} class="shrink-0" aria-label={`${site.name}, ${tr('home.aria')}`}>
      <img src={url('/logo.png')} alt="" width="538" height="128" class="h-9 w-auto min-[360px]:h-11 sm:h-12" />
    </a>

    <nav aria-label={tr('nav.label')} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.slice(1).map((item) => {
            const active = isActive(item.href, item.isHome);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'relative rounded-full px-3.5 py-2 text-[0.95rem] font-medium transition-colors hover:text-primary',
                    active ? 'text-primary' : 'text-ink/80',
                  ]}
                >
                  {tr(item.label)}
                  {active && <span class="absolute inset-x-3.5 -bottom-0.5 h-0.5 rounded-full bg-secondary" />}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitch lang={lang} page={page} compact class="sm:hidden" />
      <LangSwitch lang={lang} page={page} class="hidden sm:block" />
      <a href={supportHref} class="btn btn-primary hidden !px-5 !py-2.5 sm:inline-flex">{tr('cta.support')}</a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-primary hover:bg-primary-50 lg:hidden"
        aria-controls="menu-mobile"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label data-open={tr('nav.open')} data-close={tr('nav.close')}>{tr('nav.open')}</span>
        <Icon name="menu" class="icon-open" />
        <Icon name="x" class="icon-close hidden" />
      </button>
    </div>
  </div>

  <nav id="menu-mobile" aria-label={tr('nav.label')} class="hidden border-t border-sand bg-cream lg:hidden" data-menu>
    <ul class="container-site flex flex-col py-3">
      <li class="mb-2 flex items-center justify-between rounded-xl border border-sand bg-white px-3 py-2.5">
        <span class="text-sm font-semibold text-ink">{tr('lang.label')}</span>
        <LangSwitch lang={lang} page={page} />
      </li>
      {
        nav.map((item) => {
          const active = isActive(item.href, item.isHome);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex items-center justify-between rounded-xl px-3 py-3.5 font-display text-lg font-medium',
                  active ? 'bg-primary-50 text-primary' : 'text-ink hover:bg-sand/60',
                ]}
              >
                {tr(item.label)}
                <Icon name="arrow-right" size={18} class="opacity-50" />
              </a>
            </li>
          );
        })
      }
      <li class="mt-3 px-3 pb-2">
        <a href={supportHref} class="btn btn-primary w-full">{tr('cta.support')}</a>
      </li>

    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      btn.querySelector('.icon-open')?.classList.toggle('hidden', open);
      btn.querySelector('.icon-close')?.classList.toggle('hidden', !open);
      if (label) label.textContent = (open ? label.dataset.close : label.dataset.open) ?? '';
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
