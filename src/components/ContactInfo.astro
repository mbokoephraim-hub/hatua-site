---
import Icon from './Icon.astro';
import { getContent } from '../data';
import { getLang } from '../i18n';
import { useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const { site } = getContent(lang);

const items = [
  { icon: 'mail', label: t('contact.emailLabel'), value: site.contact.email, href: `mailto:${site.contact.email}`, action: t('contact.email') },
  { icon: 'phone', label: t('contact.phoneLabel'), value: site.contact.phoneDisplay, href: site.contact.phoneHref, action: t('contact.call') },
  { icon: 'whatsapp', label: 'WhatsApp', value: site.contact.phoneDisplay, href: site.contact.whatsappHref, action: t('contact.whatsapp'), external: true },
];
---

<ul class="grid gap-4">
  {
    items.map((item) => (
      <li>
        <a
          href={item.href}
          {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          class="card card-hover group flex items-center gap-4 !p-5"
        >
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-primary transition-colors group-hover:bg-primary group-hover:text-white">
            <Icon name={item.icon} />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium text-muted">{item.label}</span>
            <span class="block font-display font-semibold break-words text-ink">{item.value}</span>
          </span>
          <span class="sr-only">{item.action}</span>
          <Icon name="arrow-right" size={18} class="shrink-0 text-secondary transition-transform group-hover:translate-x-1" />
        </a>
      </li>
    ))
  }
  <li class="flex items-center gap-4 px-5 py-2 text-muted">
    <Icon name="map-pin" class="text-primary" />
    <span>{site.location.city}, {site.location.country}</span>
  </li>
</ul>
