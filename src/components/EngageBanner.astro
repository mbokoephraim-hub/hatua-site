---
import Icon from './Icon.astro';
import { url } from '../utils/url';

const items = [
  { icon: 'user-plus', title: 'Devenir bénévole', text: 'Donnez de votre temps et de vos compétences.', href: '/s-engager#benevolat' },
  { icon: 'handshake', title: 'Devenir partenaire', text: 'Écoles, entreprises, institutions : agissons ensemble.', href: '/s-engager#partenariats' },
  { icon: 'gift', title: 'Faire un don', text: 'Soutenez nos projets et leur déploiement.', href: '/s-engager#don' },
];
---

<section class="tone-baobab relative overflow-hidden" aria-labelledby="engagez-vous">
  <svg class="pointer-events-none absolute -left-10 bottom-0 h-full w-auto text-white/[0.05]" viewBox="0 0 400 300" aria-hidden="true">
    <path fill="currentColor" d="M0 300V0h80v60h80v60h80v60h80v60h80v60z" />
  </svg>
  <div class="container-site section relative">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">
        <span class="step-line" aria-hidden="true"><span></span><span></span><span></span></span>
        Engagez-vous
      </p>
      <h2 id="engagez-vous" class="mt-4 text-3xl font-bold sm:text-4xl">Votre pas peut changer le parcours d’un jeune.</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Il existe plusieurs façons de rejoindre l’aventure. Choisissez celle qui vous ressemble.
      </p>
    </div>
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        items.map((item, i) => (
          <li class={`reveal reveal-delay-${i + 1}`}>
            <a
              href={url(item.href)}
              class="group flex h-full flex-col rounded-2xl border border-white/15 bg-white/[0.06] p-6 transition hover:-translate-y-1 hover:border-accent-soft/60 hover:bg-white/[0.1]"
            >
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent text-primary-dark">
                <Icon name={item.icon} />
              </span>
              <h3 class="mt-5 text-xl font-semibold !text-white">{item.title}</h3>
              <p class="mt-2 flex-1 text-white/80">{item.text}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-soft">
                En savoir plus <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
