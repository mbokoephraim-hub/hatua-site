---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getContent } from '../data';
import { getLang, path, projectPath } from '../i18n';
import { useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const tr = useT(lang);
const { poles, projects, site } = getContent(lang);

const T = {
  fr: {
    title: 'Nos pôles',
    description: `Les sept pôles d’action de ${site.name} : éducation, jeunesse, femmes, communautés, compétences, leadership, recherche et impact.`,
    headerTitle: 'Sept pôles, une même direction',
    headerIntro: `${site.domainsSentence} Nos actions s’organisent autour de sept pôles complémentaires.`,
    quickNav: 'Accès rapide aux pôles',
    project: 'Projet :',
    axesTitle: 'Axes de travail envisagés',
    axesIntro: 'Pistes d’action que ce pôle pourrait développer, étape par étape.',
    ctaTitle: 'Un pôle vous parle ?',
    ctaText: 'Rejoignez-nous comme bénévole ou partenaire pour faire avancer ces projets.',
    ctaEngage: 'S’engager',
  },
  en: {
    title: 'Focus areas',
    description: `The seven focus areas of ${site.name}: education, youth, women, communities, skills, leadership, research and impact.`,
    headerTitle: 'Seven focus areas, one direction',
    headerIntro: `${site.domainsSentence} Our work is organised around seven complementary focus areas.`,
    quickNav: 'Quick access to focus areas',
    project: 'Project:',
    axesTitle: 'Planned lines of work',
    axesIntro: 'Possible actions this area could develop, step by step.',
    ctaTitle: 'Does an area speak to you?',
    ctaText: 'Join us as a volunteer or a partner to move these projects forward.',
    ctaEngage: 'Get involved',
  },
}[lang];
---

<BaseLayout title={T.title} description={T.description} page={{ key: 'poles' }}>
  <PageHeader
    tone="baobab"
    eyebrow={T.title}
    title={T.headerTitle}
    intro={T.headerIntro}
  >
    <nav aria-label={T.quickNav} class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {
          poles.map((p, i) => (
            <li>
              <a href={`#${p.id}`} class="tone-light inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition hover:bg-accent">
                <span class="font-display text-xs font-bold text-secondary">{String(i + 1).padStart(2, '0')}</span>
                {p.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHeader>

  <div>
    {
      poles.map((pole, i) => {
        const related = projects.filter((pr) => pr.pole === pole.id);
        // Alternance des couleurs de la charte pour l'icône : baobab, terre-rouge, miel
        const tile = ['bg-primary text-white', 'bg-secondary text-accent', 'bg-accent text-secondary'][i % 3];
        return (
          <section id={pole.id} aria-labelledby={`${pole.id}-titre`} class:list={['scroll-mt-20 py-14 sm:py-20', i % 2 ? 'tone-blanc' : 'tone-ivoire']}>
            <div class="container-site reveal grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16">
              <div>
                <div class="flex items-center gap-4">
                  <span class="font-display text-5xl font-bold text-accent/60 before:content-[attr(data-num)] sm:text-6xl" data-num={String(i + 1).padStart(2, '0')} aria-hidden="true"></span>
                  <span class={`inline-flex h-14 w-14 items-center justify-center rounded-2xl ${tile}`}>
                    <Icon name={pole.icon} size={28} />
                  </span>
                </div>
                <p class="mt-5 text-sm font-semibold tracking-wider text-secondary uppercase">{pole.englishName}</p>
                <h2 id={`${pole.id}-titre`} class="mt-1 text-3xl font-bold sm:text-4xl">{pole.title}</h2>
                <p class="mt-4 text-lg leading-relaxed text-muted">{pole.description}</p>
                {related.length > 0 && (
                  <div class="mt-6 flex flex-wrap gap-2">
                    {related.map((pr) => (
                      <a href={projectPath(pr.slug, lang)} class="inline-flex items-center gap-2 rounded-full bg-secondary-50 px-4 py-2 text-sm font-semibold text-secondary-dark hover:bg-secondary hover:text-white">
                        {T.project} {pr.title} <Icon name="arrow-right" size={16} />
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <div class:list={['rounded-3xl p-7 sm:p-9', i % 2 ? 'tone-miel' : 'tone-light shadow-sm ring-1 ring-sand']}>
                <h3 class="text-lg font-semibold">{T.axesTitle}</h3>
                <p class="mt-1 text-sm text-muted">{T.axesIntro}</p>
                <ul class="mt-5 space-y-3.5">
                  {pole.actions.map((a) => (
                    <li class="flex gap-3">
                      <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary-50 text-primary">
                        <Icon name="check" size={14} />
                      </span>
                      <span class="leading-relaxed">{a}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        );
      })
    }
  </div>

  <section class="section tone-terre">
    <div class="container-site reveal text-center">
      <h2 class="text-3xl font-bold">{T.ctaTitle}</h2>
      <p class="mx-auto mt-3 max-w-xl text-lg text-muted">{T.ctaText}</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href={path('engage', lang)} class="btn btn-primary">{T.ctaEngage} <Icon name="arrow-right" size={18} /></a>
        <a href={path('contact', lang)} class="btn btn-outline">{tr('cta.contact')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
