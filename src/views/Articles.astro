---
/** Liste des articles (français et anglais). */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import { getContent } from '../data';
import { articleSlug, formatDate, getArticles, groupByMonth, readingTime } from '../data/articles';
import { url } from '../utils/url';
import { articlePath, getLang, path } from '../i18n';

const lang = getLang(Astro.currentLocale);
const { site } = getContent(lang);
const articles = await getArticles(lang);
const [latest] = articles;
const months = groupByMonth(articles, lang);
const years = [...new Set(months.map((m) => m.year))];
const allTags = [...new Set(articles.flatMap((a) => a.data.tags))];

const T = {
  fr: {
    title: 'Articles',
    description: `Actualités, réflexions et nouvelles des projets de ${site.name}.`,
    headerTitle: 'Nos articles',
    headerIntro: 'Actualités de la fondation, nouvelles de nos projets et réflexions sur l’éducation et la jeunesse.',
    list: 'Liste des articles',
    emptyTitle: 'Les premiers articles arrivent bientôt',
    emptyText: 'Suivez-nous sur les réseaux sociaux pour ne rien manquer de nos premières publications.',
    contact: 'Proposer un sujet',
    featured: 'À la une',
    catalogue: 'Catalogue des articles',
    catalogueIntro: 'Tous nos articles, classés par date de publication.',
    filters: 'Filtrer les articles',
    byYear: 'Année',
    byTopic: 'Thème',
    all: 'Tous',
    count: (n: number) => (n > 1 ? `${n} articles` : `${n} article`),
    min: 'min',
    none: 'Aucun article ne correspond à ce filtre.',
  },
  en: {
    title: 'Articles',
    description: `News, reflections and project updates from ${site.name}.`,
    headerTitle: 'Our articles',
    headerIntro: 'Foundation news, updates on our projects and reflections on education and youth.',
    list: 'Article list',
    emptyTitle: 'Our first articles are coming soon',
    emptyText: 'Follow us on social media so you don’t miss our first publications.',
    contact: 'Suggest a topic',
    featured: 'Featured',
    catalogue: 'Article catalogue',
    catalogueIntro: 'All our articles, sorted by publication date.',
    filters: 'Filter articles',
    byYear: 'Year',
    byTopic: 'Topic',
    all: 'All',
    count: (n: number) => (n > 1 ? `${n} articles` : `${n} article`),
    min: 'min',
    none: 'No article matches this filter.',
  },
}[lang];
---

<BaseLayout title={T.title} description={T.description} page={{ key: 'articles' }}>
  <PageHeader tone="miel" eyebrow={T.title} title={T.headerTitle} intro={T.headerIntro} />

  <section class="section tone-ivoire" aria-label={T.list}>
    <div class="container-site">
      <h2 class="sr-only">{T.list}</h2>
      {
        latest ? (
          <>
            <p class="eyebrow mb-5">{T.featured}</p>
            <ArticleCard article={latest} featured />
          </>
        ) : (
          <div class="reveal mx-auto max-w-2xl rounded-3xl border-2 border-dashed border-sand bg-white p-10 text-center">
            <span class="mx-auto inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-50 text-primary">
              <Icon name="book" size={28} />
            </span>
            <p class="mt-5 font-display text-xl font-semibold text-secondary">{T.emptyTitle}</p>
            <p class="mx-auto mt-2 max-w-md text-muted">{T.emptyText}</p>
            <div class="mt-6 flex justify-center">
              <SocialLinks />
            </div>
            <a href={path('contact', lang)} class="btn btn-outline mt-6">
              {T.contact} <Icon name="arrow-right" size={18} />
            </a>
          </div>
        )
      }
    </div>
  </section>

  {
    latest && (
      <section class="section tone-blanc" aria-labelledby="catalogue">
        <div class="container-site">
          <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div>
              <h2 id="catalogue" class="text-3xl font-bold sm:text-4xl">{T.catalogue}</h2>
              <p class="mt-2 text-muted">{T.catalogueIntro}</p>
            </div>
            <p class="text-sm font-semibold text-muted" aria-live="polite" data-count data-one={T.count(1)} data-many={T.count(2).replace('2', '{n}')}>
              {T.count(articles.length)}
            </p>
          </div>

          <!-- Filtres (année, thème) : actifs seulement avec JavaScript -->
          <div class="mt-8 hidden flex-col gap-4 rounded-2xl bg-sand/60 p-4 sm:p-5" role="group" aria-label={T.filters} data-filters>
            <div class="flex flex-wrap items-center gap-2">
              <span class="mr-1 w-16 text-sm font-semibold text-muted">{T.byYear}</span>
              <button type="button" class="chip" aria-pressed="true" data-filter="year" data-value="">{T.all}</button>
              {years.map((y) => <button type="button" class="chip" aria-pressed="false" data-filter="year" data-value={String(y)}>{y}</button>)}
            </div>
            {allTags.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                <span class="mr-1 w-16 text-sm font-semibold text-muted">{T.byTopic}</span>
                <button type="button" class="chip" aria-pressed="true" data-filter="tag" data-value="">{T.all}</button>
                {allTags.map((tag) => <button type="button" class="chip" aria-pressed="false" data-filter="tag" data-value={tag}>{tag}</button>)}
              </div>
            )}
          </div>

          <!-- Frise chronologique par mois -->
          <ol class="mt-10">
            {months.map((m) => (
              <li class="catalogue-mois grid gap-4 border-t border-sand py-8 md:grid-cols-[13rem_1fr] md:gap-10" data-month data-year={m.year}>
                <h3 class="md:sticky md:top-28 md:self-start">
                  <span class="block font-display text-2xl font-bold capitalize text-secondary">{m.label}</span>
                  <span class="mt-1 block text-sm text-muted" data-month-count>{T.count(m.items.length)}</span>
                </h3>
                <ul class="grid gap-4">
                  {m.items.map((a) => (
                    <li data-item data-year={a.data.date.getUTCFullYear()} data-tags={JSON.stringify(a.data.tags)}>
                      <a href={articlePath(articleSlug(a), lang)} class="group grid grid-cols-[6.5rem_1fr] items-center gap-4 rounded-2xl border border-sand bg-white p-3 transition hover:border-hibiscus hover:shadow-md sm:grid-cols-[10rem_1fr] sm:gap-6">
                        {a.data.image ? (
                          <img src={url(a.data.image)} alt="" width="320" height="200" loading="lazy" class="aspect-[16/10] w-full rounded-xl bg-sand object-cover" />
                        ) : (
                          <span class="flex aspect-[16/10] w-full items-center justify-center rounded-xl bg-primary-50 text-primary"><Icon name="book" size={28} /></span>
                        )}
                        <span class="min-w-0">
                          <span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold text-muted">
                            <time datetime={a.data.date.toISOString()} class="text-secondary">{formatDate(a.data.date, lang)}</time>
                            <span>{readingTime(a)} {T.min}</span>
                            <span class="hidden items-center gap-1" data-views-for={`${lang}/${articleSlug(a)}`} data-one={lang === 'fr' ? 'vue' : 'view'} data-label={lang === 'fr' ? 'vues' : 'views'}><span data-n></span></span>
                            {a.data.draft && <span class="rounded-full bg-secondary px-2 py-0.5 text-white">{lang === 'fr' ? 'Brouillon' : 'Draft'}</span>}
                          </span>
                          <span class="mt-1.5 block font-display text-lg leading-snug font-semibold text-ink group-hover:underline sm:text-xl">{a.data.title}</span>
                          <span class="mt-1 hidden text-sm leading-relaxed text-muted sm:line-clamp-2">{a.data.description}</span>
                          {a.data.tags.length > 0 && (
                            <span class="mt-2 flex flex-wrap gap-1.5">
                              {a.data.tags.map((tag) => <span class="rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-semibold text-primary">{tag}</span>)}
                            </span>
                          )}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
          <p class="mt-6 hidden rounded-2xl bg-sand/60 p-6 text-center text-muted" data-empty>{T.none}</p>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  if (filters) {
    filters.classList.remove('hidden');
    filters.classList.add('flex');
    const state: Record<string, string> = { year: '', tag: '' };
    const count = document.querySelector<HTMLElement>('[data-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const apply = () => {
      let total = 0;
      document.querySelectorAll<HTMLElement>('[data-month]').forEach((month) => {
        let visible = 0;
        month.querySelectorAll<HTMLElement>('[data-item]').forEach((item) => {
          const tags: string[] = JSON.parse(item.dataset.tags ?? '[]');
          const show = (!state.year || item.dataset.year === state.year) && (!state.tag || tags.includes(state.tag));
          item.hidden = !show;
          if (show) visible++;
        });
        month.hidden = visible === 0;
        const mc = month.querySelector<HTMLElement>('[data-month-count]');
        if (mc && count) mc.textContent = visible === 1 ? (count.dataset.one ?? '') : (count.dataset.many ?? '').replace('{n}', String(visible));
        total += visible;
      });
      if (count) count.textContent = total === 1 ? (count.dataset.one ?? '') : (count.dataset.many ?? '').replace('{n}', String(total));
      if (empty) empty.classList.toggle('hidden', total > 0);
    };
    filters.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter!;
        state[key] = btn.dataset.value ?? '';
        filters.querySelectorAll<HTMLButtonElement>(`[data-filter="${key}"]`).forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply();
      });
    });
  }
</script>
