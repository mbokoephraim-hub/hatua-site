---
/** Page d'accueil (français et anglais). Textes propres à la page : objet T ci-dessous. */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSteps from '../components/HeroSteps.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PoleCard from '../components/PoleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EngageBanner from '../components/EngageBanner.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, articleSlug } from '../data/articles';
import { getContent } from '../data';
import { getLang, path, quote, articlePath } from '../i18n';
import { useT } from '../i18n/ui';
import { url } from '../utils/url';

const lang = getLang(Astro.currentLocale);
const tr = useT(lang);
const { site, fondatrice, poles, projects } = getContent(lang);
const featured = projects[0];
const latest = (await getArticles(lang)).filter((a) => !articleSlug(a).startsWith('_')).slice(0, 3);
const news = latest[0] ? { title: latest[0].data.title, href: articlePath(articleSlug(latest[0]), lang), image: latest[0].data.image } : null;

const T = {
  fr: {
    founderTitle: 'À la découverte de la fondatrice',
    founderCta: `Découvrir ${fondatrice.name}`,
    convictionEyebrow: 'Notre conviction',
    convictionTitle: 'Étape après étape',
    meaning: `signifie ${quote(site.nameMeaning.meaning, lang)} en ${site.nameMeaning.language}. Un nom qui dit tout de notre façon d’agir.`,
    whoWeAre: 'Qui sommes-nous',
    polesEyebrow: 'Nos pôles',
    polesTitle: 'Sept pôles pour avancer ensemble',
    allPoles: 'Tous les pôles',
    poleCtaTitle: 'Un pôle vous parle ?',
    poleCtaText: 'Engagez-vous à nos côtés comme bénévole ou partenaire.',
    poleCtaLink: 'S’engager',
    projectEyebrow: 'Projet phare',
    projectTitle: 'Notre premier pas : ÉCHOS',
    contactTitle: 'Parlons de votre prochain pas',
    contactIntro: 'Une question, une idée, une envie de collaborer ? Nous serons heureux d’échanger avec vous.',
  },
  en: {
    founderTitle: 'Meet the founder',
    founderCta: `Discover ${fondatrice.name}`,
    convictionEyebrow: 'Our belief',
    convictionTitle: 'Step by step',
    meaning: `means ${quote(site.nameMeaning.meaning, lang)} in ${site.nameMeaning.language}. A name that says everything about the way we work.`,
    whoWeAre: 'Who we are',
    polesEyebrow: 'Focus areas',
    polesTitle: 'Seven focus areas to move forward together',
    allPoles: 'All focus areas',
    poleCtaTitle: 'Does an area speak to you?',
    poleCtaText: 'Join us as a volunteer or a partner.',
    poleCtaLink: 'Get involved',
    projectEyebrow: 'Flagship project',
    projectTitle: 'Our first step: ÉCHOS',
    contactTitle: 'Let’s talk about your next step',
    contactIntro: 'A question, an idea, a wish to collaborate? We would be happy to hear from you.',
  },
}[lang];
---

<BaseLayout page={{ key: 'home' }} news={news}>
  <!-- HERO -->
  <section class="tone-ivoire hero-immersive relative overflow-hidden" data-hero>
    <div class="pointer-events-none absolute -top-40 -right-40 h-[32rem] w-[32rem] rounded-full bg-primary-50 blur-3xl" data-parallax="-0.25" aria-hidden="true"></div>
    <div class="container-site relative grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:py-24">
      <div class="hero-text">
        <p class="eyebrow">
          <span class="step-line" aria-hidden="true"><span></span><span></span><span></span></span>
          {site.location.city}, {site.location.countryShort}
        </p>
        <h1 class="mt-5 text-5xl leading-[1.05] font-bold sm:text-6xl lg:text-7xl">
          {site.nameAlt.split(' ')[0]}<br />
          <span class="text-secondary">Foundation</span>
        </h1>
        <p class="mt-5 font-display text-2xl font-semibold text-primary sm:text-3xl">{site.slogan}</p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{site.shortMission}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={path('poles', lang)} class="btn btn-green">{tr('cta.discover')} <Icon name="arrow-right" size={18} /></a>
          <a href={path('engageDonate', lang)} class="btn btn-outline">{tr('cta.support')}</a>
        </div>
      </div>
      <HeroSteps />
    </div>
  </section>
  <!-- À LA UNE : les articles disponibles -->
  {
    latest.length > 0 && (
      <section class="news-band" aria-labelledby="a-la-une">
        <div class="container-site">
          <div class="news-head reveal">
            <span class="news-live"><i /> {lang === 'fr' ? 'À la une' : 'Featured'}</span>
            <h2 id="a-la-une">{lang === 'fr' ? 'Nos derniers articles, disponibles à la lecture' : 'Our latest articles, ready to read'}</h2>
            <a href={path('articles', lang)} class="news-all">{lang === 'fr' ? 'Tous les articles' : 'All articles'} <Icon name="arrow-right" size={16} /></a>
          </div>
          <div class:list={['news-grid mt-8', latest.length === 1 && 'is-single']}>
            {latest.map((a, i) => (
              <div class={`reveal reveal-delay-${i + 1}`}>
                <ArticleCard article={a} featured={i === 0} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }


  <!-- À LA DÉCOUVERTE DE LA FONDATRICE -->
  <section class="tone-blanc py-12 sm:py-16" aria-labelledby="fondatrice-apercu">
    <div class="container-site reveal grid items-center gap-8 sm:grid-cols-[auto_1fr] sm:gap-12">
      <div class="founder-orbit mx-auto" data-founder>
        <span class="fo-ring" aria-hidden="true"></span>
        <span class="fo-ring2" aria-hidden="true"></span>
        <span class="fo-orbit o1" aria-hidden="true"><i></i></span>
        <span class="fo-orbit o2" aria-hidden="true"><i></i></span>
        <span class="fo-orbit o3" aria-hidden="true"><i></i></span>
        <div class="fo-card">
          <img
            src={url(fondatrice.photos.portrait.src)}
            alt={fondatrice.photos.portrait.alt}
            width="176"
            height="176"
            loading="lazy"
            class="fo-photo object-cover object-[center_18%]"
          />
          <span class="fo-shine" aria-hidden="true"></span>
        </div>
      </div>
      <div class="text-center sm:text-left">
        <h2 id="fondatrice-apercu" class="text-2xl font-bold sm:text-3xl">{T.founderTitle}</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted">{fondatrice.teaser}</p>
        <a href={path('founder', lang)} class="btn btn-primary mt-6">
          {T.founderCta} <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- ÉTAPE APRÈS ÉTAPE -->
  <section class="section tone-terre" aria-labelledby="conviction">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <SectionTitle number="01" eyebrow={T.convictionEyebrow} title={T.convictionTitle} id="conviction">
        <p class="mt-5 text-muted">
          <em class="font-display font-semibold text-eyebrow not-italic">{quote(site.nameMeaning.word, lang)}</em>
          {T.meaning}
        </p>
        <a href={path('about', lang)} class="mt-6 inline-flex items-center gap-1.5 font-semibold text-link hover:underline">
          {T.whoWeAre} <Icon name="arrow-right" size={18} />
        </a>
      </SectionTitle>

      <ol class="steps-climb space-y-5" data-steps>
        {
          site.vision.map((p, i) => (
            <li class="step-item flex gap-5" style={`--i:${i}`} data-step>
              <span class="step-dot flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-eyebrow/60 font-display text-sm font-bold text-eyebrow">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="pt-1.5 text-lg leading-relaxed text-ink">{p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- PÔLES -->
  <section class="section tone-ivoire relative overflow-hidden" aria-labelledby="poles-titre">
    <span class="big-num" data-parallax="0.35" aria-hidden="true">7</span>
    <div class="container-site relative">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionTitle number="02" eyebrow={T.polesEyebrow} title={T.polesTitle} intro={site.domainsSentence} id="poles-titre" />
        <a href={path('poles', lang)} class="btn btn-outline shrink-0 self-start md:self-auto">{T.allPoles}</a>
      </div>
      <ul class="domino mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-domino>
        {poles.map((pole, i) => <li style={`--i:${i}`}><PoleCard pole={pole} index={i} /></li>)}
        <li class="reveal" style={`--i:${poles.length}`}>
          <a href={path('engage', lang)} class="group flex h-full min-h-56 flex-col justify-between rounded-2xl bg-secondary p-6 text-white transition hover:-translate-y-1 hover:bg-secondary-dark">
            <span class="step-line" aria-hidden="true"><span class="!bg-white/50"></span><span class="!bg-white/75"></span><span class="!bg-white"></span></span>
            <span>
              <span class="block font-display text-xl font-semibold">{T.poleCtaTitle}</span>
              <span class="mt-2 block text-white">{T.poleCtaText}</span>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold">{T.poleCtaLink} <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" /></span>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- PROJET PHARE -->
  {
    featured && (
      <section class="section tone-miel" aria-labelledby="projet-phare">
        <div class="container-site">
          <SectionTitle number="03" eyebrow={T.projectEyebrow} title={T.projectTitle} id="projet-phare" />
          <div class="mt-10">
            <ProjectCard project={featured} />
          </div>
        </div>
      </section>
    )
  }

  <!-- ENGAGEZ-VOUS -->
  <EngageBanner />

  <!-- CONTACT -->
  <section class="section tone-ivoire" aria-labelledby="contact-apercu">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <SectionTitle number="04" eyebrow={tr('nav.contact')} title={T.contactTitle} intro={T.contactIntro} id="contact-apercu">
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={path('contact', lang)} class="btn btn-green">{tr('cta.contact')} <Icon name="arrow-right" size={18} /></a>
          <a href={site.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            <Icon name="whatsapp" size={18} /> WhatsApp
          </a>
        </div>
      </SectionTitle>
      <div class="card reveal !p-7 sm:!p-9">
        <ul class="space-y-4">
          <li class="flex items-center gap-4">
            <Icon name="mail" class="shrink-0 text-primary" />
            <a href={`mailto:${site.contact.email}`} class="font-medium break-all hover:text-primary hover:underline">{site.contact.email}</a>
          </li>
          <li class="flex items-center gap-4">
            <Icon name="phone" class="shrink-0 text-primary" />
            <a href={site.contact.phoneHref} class="font-medium hover:text-primary hover:underline">{site.contact.phoneDisplay}</a>
          </li>
          <li class="flex items-center gap-4">
            <Icon name="map-pin" class="shrink-0 text-primary" />
            <span class="font-medium">{site.location.city}, {site.location.country}</span>
          </li>
        </ul>
        <hr class="my-6 border-sand" />
        <p class="font-display font-semibold text-primary-dark">{tr('footer.follow')}</p>
        <div class="mt-3"><SocialLinks /></div>
      </div>
    </div>
  </section>
</BaseLayout>
