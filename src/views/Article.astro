---
/** Page d'un article (français et anglais). Le texte vient du fichier Markdown de l'article. */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import { getContent } from '../data';
import { articleSlug, formatDate, getArticles, readingTime, type Article } from '../data/articles';
import { articlePath, getLang, otherLang, path } from '../i18n';
import { url } from '../utils/url';

interface Props {
  article: Article;
}
const { article } = Astro.props;
const lang = getLang(Astro.currentLocale);
const { site } = getContent(lang);
const { Content } = await render(article);
// Typographie française : espace insécable fine avant « : ; ! ? » » et après « « » (uniquement dans le texte, pas dans les balises)
const typo = (html: string) =>
  html.replace(/>([^<]+)</g, (_, text: string) => `>${text.replace(/ ([:;!?»])/g, '\u202F$1').replace(/« /g, '«\u202F')}<`);
// Les schémas et graphiques SVG (<div data-inline-svg="/images/…svg">) sont insérés directement dans la page :
// leurs textes restent lisibles par les lecteurs d'écran et prennent la police du site.
const inlineSvg = (html: string) =>
  html.replace(/<div data-inline-svg="([^"]+)"><\/div>/g, (_, src: string) => {
    try {
      const svg = readFileSync(join(process.cwd(), 'public', src), 'utf8').replace(/<\?xml[^>]*>\s*/, '');
      return `<div class="svg-inline">${svg}</div>`;
    } catch {
      return `<img src="${url(src)}" alt="" />`;
    }
  });
const html = article.rendered?.html ? inlineSvg(lang === 'fr' ? typo(article.rendered.html) : article.rendered.html) : null;
const { title, description, date, author, authorRole, authorImage, authorLink, kicker, image, imageAlt, tags, translation, draft } = article.data;
const { fondatrice } = getContent(lang);
// Encadré « À propos de l'autrice » : renseigné automatiquement quand authorLink vaut « founder »
const authorBox =
  authorLink === 'founder'
    ? { photo: '/images/fondatrice-640.webp', bio: fondatrice.teaser, href: path('founder', lang) }
    : authorImage
      ? { photo: authorImage, bio: authorRole ?? '', href: authorLink }
      : null;
const slug = articleSlug(article);
// Identifiant de l'article pour les compteurs et les commentaires (ex. « fr/mon-article »)
const statsKey = `${lang}/${slug}`;

// Version dans l'autre langue (si le champ « translation » pointe vers un article existant)
const other = otherLang(lang);
const translated = translation ? (await getArticles(other)).find((a) => articleSlug(a) === translation) : undefined;
const slugs = { [lang]: slug, ...(translated ? { [other]: translation } : {}) };

const related = (await getArticles(lang)).filter((a) => a.id !== article.id).slice(0, 3);
const pageUrl = new URL(articlePath(slug, lang), Astro.site).href;
const share = encodeURIComponent(pageUrl);
const shareText = encodeURIComponent(`${title} — ${pageUrl}`);

const T = {
  fr: {
    breadcrumb: 'Fil d’Ariane',
    articles: 'Articles',
    by: 'Par',
    about: 'À propos de l’autrice',
    profile: 'Découvrir son parcours',
    min: 'min de lecture',
    draft: 'Brouillon : cet article n’est pas publié',
    share: 'Partager l’article',
    copy: 'Copier le lien',
    copied: 'Lien copié !',
    related: 'À lire aussi',
    back: 'Tous les articles',
    ctaTitle: 'Envie d’agir à nos côtés ?',
    ctaText: 'Bénévolat, partenariat, don : chaque pas compte.',
    cta: 'S’engager',
    views: 'vues',
    view: 'vue',
    reads: 'lectures complètes',
    read: 'lecture complète',
    comments: 'Commentaires',
    commentsIntro: 'Réagissez à cet article. Votre commentaire sera publié après relecture par l’équipe.',
    noComments: 'Aucun commentaire pour l’instant : soyez la première ou le premier à réagir.',
    name: 'Votre nom ou prénom',
    email: 'Votre e-mail (facultatif, jamais publié)',
    message: 'Votre commentaire',
    send: 'Envoyer le commentaire',
    sending: 'Envoi…',
    thanks: 'Merci ! Votre commentaire a bien été reçu. Il apparaîtra ici après relecture par l’équipe.',
    error: 'L’envoi n’a pas abouti. Vérifiez les champs et réessayez dans un instant.',
    rate: 'Vous avez envoyé plusieurs commentaires en peu de temps. Réessayez dans quelques minutes.',
    replyFrom: 'Réponse de HATUA Foundation',
    pending: 'En attente de relecture : visible seulement par vous pour l’instant',
    like: 'J’aime',
    likeAria: 'J’aime ce commentaire',
    privacy: 'Votre nom et votre commentaire seront visibles par tous. N’indiquez pas d’informations personnelles sur un enfant.',
    honeypot: 'Ne pas remplir ce champ',
  },
  en: {
    breadcrumb: 'Breadcrumb',
    articles: 'Articles',
    by: 'By',
    about: 'About the author',
    profile: 'Read her story',
    min: 'min read',
    draft: 'Draft: this article is not published',
    share: 'Share this article',
    copy: 'Copy link',
    copied: 'Link copied!',
    related: 'Read also',
    back: 'All articles',
    ctaTitle: 'Would you like to act with us?',
    ctaText: 'Volunteering, partnership, donation: every step counts.',
    cta: 'Get involved',
    views: 'views',
    view: 'view',
    reads: 'full reads',
    read: 'full read',
    comments: 'Comments',
    commentsIntro: 'Share your thoughts on this article. Your comment will be published after review by our team.',
    noComments: 'No comments yet: be the first to respond.',
    name: 'Your name or first name',
    email: 'Your email (optional, never published)',
    message: 'Your comment',
    send: 'Post comment',
    sending: 'Sending…',
    thanks: 'Thank you! Your comment has been received. It will appear here once our team has reviewed it.',
    error: 'Sending failed. Please check the fields and try again in a moment.',
    rate: 'You have posted several comments in a short time. Please try again in a few minutes.',
    replyFrom: 'Reply from HATUA Foundation',
    pending: 'Awaiting review: only visible to you for now',
    like: 'Like',
    likeAria: 'Like this comment',
    privacy: 'Your name and comment will be visible to everyone. Do not share personal information about a child.',
    honeypot: 'Leave this field empty',
  },
}[lang];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: lang,
  author: { '@type': author === site.nameAlt || author === site.name ? 'Organization' : 'Person', name: author, ...(authorBox?.href ? { url: new URL(authorBox.href, Astro.site).href } : {}) },
  publisher: { '@type': 'NGO', name: site.nameAlt, logo: { '@type': 'ImageObject', url: new URL(url('/icon-512.png'), Astro.site).href } },
  mainEntityOfPage: pageUrl,
  ...(image ? { image: new URL(url(image), Astro.site).href } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={image}
  imageAlt={imageAlt}
  noindex={draft}
  structuredData={articleLd}
  page={{ key: 'article', slugs }}
>
  <article>
    <header class="tone-ivoire">
      <div class="container-site max-w-4xl pt-12 pb-10 sm:pt-16">
        <nav aria-label={T.breadcrumb} class="text-sm text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={path('articles', lang)} class="inline-flex items-center gap-1.5 hover:text-secondary hover:underline"><Icon name="arrow-left" size={14} /> {T.articles}</a></li>
          </ol>
        </nav>
        {draft && <p class="mt-6 rounded-xl bg-secondary px-4 py-2 text-sm font-semibold text-white">{T.draft}</p>}
        {tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2 text-xs font-semibold">
            {tags.map((tag) => <li class="rounded-full bg-primary-50 px-3 py-1 text-primary">{tag}</li>)}
          </ul>
        )}
        {kicker && <p class="eyebrow mt-6">{kicker}</p>}
        <h1 class="mt-3 text-4xl leading-tight font-bold sm:text-5xl">{title}</h1>
        <p class="mt-5 text-xl leading-relaxed text-muted">{description}</p>
        <p class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
          <span class="inline-flex items-center gap-3">
            {authorImage && <img src={url(authorImage)} alt="" width="48" height="48" class="h-12 w-12 rounded-full object-cover ring-2 ring-hibiscus/60" />}
            <span>
              {T.by} <strong class="font-semibold text-ink">{author}</strong>
              {authorRole && <span class="block text-xs">{authorRole}</span>}
            </span>
          </span>
          <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
          <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={15} /> {readingTime(article)} {T.min}</span>
          <!-- Compteurs : affichés seulement si le service répond -->
          <span class="hidden items-center gap-1.5" data-stat="views"><Icon name="eye" size={15} /> <span data-n></span></span>
          <span class="hidden items-center gap-1.5" data-stat="reads"><Icon name="book" size={15} /> <span data-n></span></span>
          <a href="#commentaires" class="hidden items-center gap-1.5 hover:text-secondary hover:underline" data-stat="comments"><Icon name="message" size={15} /> <span data-n></span></a>
        </p>
      </div>
    </header>

    {
      image && (
        <figure class="tone-ivoire">
          <div class="container-site max-w-5xl pb-4">
            <img src={url(image)} alt={imageAlt ?? ''} width="1600" height="900" fetchpriority="high" class="aspect-[16/9] w-full rounded-3xl object-cover" />
          </div>
        </figure>
      )
    }

    <div class="tone-blanc">
      <div class="container-site max-w-3xl py-12 sm:py-16">
        <div class="prose-article">
          {html ? <Fragment set:html={html} /> : <Content />}
        </div>

        {
          authorBox && (
            <aside class="card mt-14 flex flex-col gap-6 sm:flex-row sm:items-center" aria-labelledby="a-propos-auteur">
              <img src={url(authorBox.photo)} alt={author} width="160" height="168" loading="lazy" class="h-36 w-36 shrink-0 rounded-2xl object-cover object-top sm:h-40 sm:w-40" />
              <div>
                <p id="a-propos-auteur" class="eyebrow">{T.about}</p>
                <p class="mt-2 font-display text-xl font-bold text-secondary">{author}</p>
                {authorBox.bio && <p class="mt-2 leading-relaxed text-muted">{authorBox.bio}</p>}
                {authorBox.href && (
                  <a href={authorBox.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary hover:underline">
                    {T.profile} <Icon name="arrow-right" size={16} />
                  </a>
                )}
              </div>
            </aside>
          )
        }

        <!-- Repère de fin de lecture : atteint = « lecture complète » -->
        <div data-read-end aria-hidden="true"></div>

        <!-- Partage -->
        <div class="mt-14 border-t border-sand pt-8">
          <p class="font-display font-semibold text-secondary">{T.share}</p>
          <ul class="mt-4 flex flex-wrap gap-2.5">
            <li><a href={`https://wa.me/?text=${shareText}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" title="WhatsApp" class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary-50 text-primary transition hover:bg-primary hover:text-white"><Icon name="whatsapp" size={20} /></a></li>
            <li><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn" class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary-50 text-primary transition hover:bg-primary hover:text-white"><Icon name="linkedin" size={20} /></a></li>
            <li><a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook" class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary-50 text-primary transition hover:bg-primary hover:text-white"><Icon name="facebook" size={20} /></a></li>
            <li>
              <button type="button" data-copy-link={pageUrl} data-copied={T.copied} class="inline-flex h-11 items-center gap-2 rounded-full bg-primary-50 px-4 text-sm font-semibold text-primary transition hover:bg-primary hover:text-white">
                <Icon name="link" size={18} /> <span data-copy-label>{T.copy}</span>
              </button>
            </li>
          </ul>
        </div>

        <!-- Commentaires (publiés après validation dans ÉCHOS) -->
        <section id="commentaires" class="mt-14 border-t border-sand pt-8" aria-labelledby="titre-commentaires" data-comments={statsKey}
          data-l-view={T.view} data-l-views={T.views} data-l-read={T.read} data-l-reads={T.reads}
          data-l-thanks={T.thanks} data-l-error={T.error} data-l-rate={T.rate} data-l-reply={T.replyFrom} data-l-pending={T.pending} data-l-like={T.like} data-l-like-aria={T.likeAria} data-l-sending={T.sending} data-l-send={T.send} data-lang={lang}>
          <h2 id="titre-commentaires" class="font-display text-2xl font-bold">{T.comments} <span class="text-muted" data-comment-count></span></h2>
          <p class="mt-2 text-muted">{T.commentsIntro}</p>
          <ol class="mt-6 grid gap-4" data-comment-list></ol>
          <p class="mt-4 hidden text-muted" data-no-comments>{T.noComments}</p>

          <form class="card mt-8 grid gap-4" data-comment-form novalidate>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="c-name" class="mb-1.5 block text-sm font-semibold">{T.name} <span class="text-secondary" aria-hidden="true">*</span></label>
                <input id="c-name" name="name" type="text" required minlength="2" maxlength="60" autocomplete="name" class="w-full rounded-xl border border-sand bg-white px-4 py-3" />
              </div>
              <div>
                <label for="c-email" class="mb-1.5 block text-sm font-semibold">{T.email}</label>
                <input id="c-email" name="email" type="email" maxlength="150" autocomplete="email" class="w-full rounded-xl border border-sand bg-white px-4 py-3" />
              </div>
            </div>
            <div>
              <label for="c-message" class="mb-1.5 block text-sm font-semibold">{T.message} <span class="text-secondary" aria-hidden="true">*</span></label>
              <textarea id="c-message" name="message" required minlength="3" maxlength="2000" rows="5" class="w-full rounded-xl border border-sand bg-white px-4 py-3"></textarea>
            </div>
            <p class="hidden" aria-hidden="true"><label>{T.honeypot} <input name="website" tabindex="-1" autocomplete="off" /></label></p>
            <p class="text-sm text-muted">{T.privacy}</p>
            <div><button type="submit" class="btn btn-primary">{T.send} <Icon name="send" size={18} /></button></div>
            <p class="hidden rounded-xl p-4 font-medium" role="status" aria-live="polite" tabindex="-1" data-comment-status></p>
          </form>
        </section>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section tone-ivoire" aria-labelledby="a-lire-aussi">
        <div class="container-site">
          <h2 id="a-lire-aussi" class="text-3xl font-bold">{T.related}</h2>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((a) => <li><ArticleCard article={a} /></li>)}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section tone-terre">
    <div class="container-site flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{T.ctaTitle}</h2>
        <p class="mt-2 text-muted">{T.ctaText}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={path('engage', lang)} class="btn btn-primary">{T.cta} <Icon name="arrow-right" size={18} /></a>
        <a href={path('articles', lang)} class="btn btn-outline">{T.back}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // --- Vues, lectures complètes et commentaires (module PHP /api, sur Hostinger)
  const box = document.querySelector<HTMLElement>('[data-comments]');
  if (box) {
    const key = box.dataset.comments!;
    const L = box.dataset;
    const fmt = new Intl.NumberFormat(L.lang === 'en' ? 'en-GB' : 'fr-FR');
    const plural = (n: number, one: string, many: string) => `${fmt.format(n)} ${n > 1 ? many : one}`;
    const show = (name: string, text: string) => {
      const el = document.querySelector<HTMLElement>(`[data-stat="${name}"]`);
      if (!el) return;
      el.querySelector('[data-n]')!.textContent = text;
      el.classList.remove('hidden');
      el.classList.add('inline-flex');
    };
    const post = (url: string, body: object) =>
      fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

    // 1. Une vue (comptée une fois par jour et par personne côté serveur)
    post('/api/stats.php', { slug: key, type: 'view' })
      .catch(() => undefined)
      .then(() => fetch(`/api/stats.php?slugs=${encodeURIComponent(key)}`))
      .then((r) => (r && r.ok ? r.json() : null))
      .then((d) => {
        const s = d?.[key];
        if (!s) return;
        show('views', plural(s.views, L.lView!, L.lViews!));
        show('reads', plural(s.reads, L.lRead!, L.lReads!));
        show('comments', fmt.format(s.comments));
      })
      .catch(() => undefined);

    // 2. Une lecture complète : la fin de l'article est atteinte après au moins 30 secondes sur la page
    const end = document.querySelector('[data-read-end]');
    const start = Date.now();
    if (end && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting) && Date.now() - start > 30000) {
          io.disconnect();
          post('/api/stats.php', { slug: key, type: 'read' }).catch(() => undefined);
        }
      });
      io.observe(end);
    }

    // 3. Commentaires validés + ceux de ce visiteur encore en attente (gardés sur son appareil)
    type C = { id?: number; name: string; message: string; reply?: string | null; created_at: string; pending?: boolean; likes?: number };
    // « J'aime » déjà donnés depuis cet appareil
    const likedKey = 'hatua-liked-comments';
    const liked = new Set<number>((() => {
      try {
        return JSON.parse(localStorage.getItem(likedKey) ?? '[]');
      } catch {
        return [];
      }
    })());
    const saveLiked = () => {
      try {
        localStorage.setItem(likedKey, JSON.stringify([...liked].slice(-500)));
      } catch {
        /* stockage indisponible */
      }
    };
    const heart = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>';
    const likeButton = (c: C) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      const paint = (n: number) => {
        const on = liked.has(c.id!);
        btn.className = `mt-3 inline-flex min-h-9 items-center gap-1.5 rounded-full px-3 text-sm font-semibold transition ${on ? 'bg-secondary text-white' : 'bg-primary-50 text-primary hover:bg-secondary-50 hover:text-secondary'}`;
        btn.setAttribute('aria-pressed', String(on));
        btn.setAttribute('aria-label', `${L.lLikeAria} (${n})`);
        btn.innerHTML = `${heart}<span>${L.lLike}</span><span aria-hidden="true">· ${n}</span>`;
      };
      let count = c.likes ?? 0;
      paint(count);
      btn.addEventListener('click', async () => {
        const unlike = liked.has(c.id!);
        btn.disabled = true;
        try {
          const r = await post('/api/comments.php', { like: c.id, unlike });
          if (!r.ok) return;
          count = (await r.json()).likes ?? count;
          if (unlike) liked.delete(c.id!);
          else liked.add(c.id!);
          saveLiked();
          paint(count);
        } finally {
          btn.disabled = false;
        }
      });
      return btn;
    };
    const list = box.querySelector<HTMLOListElement>('[data-comment-list]')!;
    const dateFmt = new Intl.DateTimeFormat(L.lang === 'en' ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    const mineKey = `hatua-comments:${key}`;
    const loadMine = (): C[] => {
      try {
        return JSON.parse(localStorage.getItem(mineKey) ?? '[]');
      } catch {
        return [];
      }
    };
    const saveMine = (items: C[]) => {
      try {
        localStorage.setItem(mineKey, JSON.stringify(items.slice(-10)));
      } catch {
        /* stockage indisponible */
      }
    };
    const render = (c: C) => {
      // textContent uniquement : aucun HTML venant des visiteurs n'est interprété
      const li = document.createElement('li');
      li.className = c.pending ? 'card border-dashed !border-hibiscus' : 'card';
      const head = document.createElement('p');
      head.className = 'text-sm text-muted';
      const who = document.createElement('strong');
      who.className = 'font-semibold text-ink';
      who.textContent = c.name;
      head.append(who, ` · ${dateFmt.format(new Date(c.created_at))}`);
      if (c.pending) {
        const tag = document.createElement('span');
        tag.className = 'mt-1 block w-fit rounded-full bg-accent px-3 py-0.5 text-xs font-semibold text-encre sm:ml-2 sm:mt-0 sm:inline-block';
        tag.textContent = L.lPending!;
        head.append(tag);
      }
      const body = document.createElement('p');
      body.className = 'mt-2 whitespace-pre-line';
      body.textContent = c.message;
      li.append(head, body);
      return li;
    };
    const showAll = (approved: C[]) => {
      const ids = new Set(approved.map((c) => c.id));
      // Un commentaire publié n'est plus « en attente » : on l'oublie sur l'appareil
      const month = Date.now() - 30 * 86400000;
      const mine = loadMine().filter((c) => !ids.has(c.id) && new Date(c.created_at).getTime() > month);
      saveMine(mine);
      list.replaceChildren();
      box.querySelector('[data-comment-count]')!.textContent = approved.length ? `(${approved.length})` : '';
      box.querySelector('[data-no-comments]')!.classList.toggle('hidden', approved.length + mine.length > 0);
      for (const c of [...approved, ...mine.map((m) => ({ ...m, pending: true }))]) {
        const li = render(c);
        if (!c.pending && c.id) li.append(likeButton(c));
        if (c.reply) {
            const rep = document.createElement('div');
            rep.className = 'mt-4 rounded-xl border-l-4 border-hibiscus bg-sand/60 p-4';
            const t = document.createElement('p');
            t.className = 'text-sm font-semibold text-secondary';
            t.textContent = L.lReply!;
            const rb = document.createElement('p');
            rb.className = 'mt-1 whitespace-pre-line';
            rb.textContent = c.reply;
            rep.append(t, rb);
            li.append(rep);
        }
        list.append(li);
      }
    };
    let approvedCache: C[] = [];
    fetch(`/api/comments.php?slug=${encodeURIComponent(key)}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        approvedCache = d?.comments ?? [];
        showAll(approvedCache);
      })
      .catch(() => showAll([]));

    // 4. Envoi d'un commentaire
    const form = box.querySelector<HTMLFormElement>('[data-comment-form]')!;
    const status = form.querySelector<HTMLElement>('[data-comment-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const opened = Date.now();
    const say = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.classList.remove('hidden', 'bg-primary-50', 'text-primary-dark', 'bg-secondary-50', 'text-secondary-dark');
      status.classList.add(...(ok ? ['bg-primary-50', 'text-primary-dark'] : ['bg-secondary-50', 'text-secondary-dark']));
      status.focus();
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const f = new FormData(form);
      button.disabled = true;
      try {
        const r = await post('/api/comments.php', {
          slug: key,
          name: f.get('name'),
          email: f.get('email'),
          message: f.get('message'),
          website: f.get('website'),
          elapsed: Math.round((Date.now() - opened) / 1000),
        });
        if (r.status === 429) return say(L.lRate!, false);
        if (!r.ok) throw new Error(String(r.status));
        const res = await r.json().catch(() => ({}));
        saveMine([...loadMine(), { id: res.id, name: String(f.get('name')), message: String(f.get('message')), created_at: new Date().toISOString() }]);
        showAll(approvedCache);
        form.reset();
        say(L.lThanks!, true);
      } catch {
        say(L.lError!, false);
      } finally {
        button.disabled = false;
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyLink ?? location.href);
        const label = btn.querySelector('[data-copy-label]');
        if (label) {
          const before = label.textContent;
          label.textContent = btn.dataset.copied ?? '';
          setTimeout(() => (label.textContent = before), 2000);
        }
      } catch {
        /* presse-papiers indisponible : rien à faire */
      }
    });
  });
</script>
