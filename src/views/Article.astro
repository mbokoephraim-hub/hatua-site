---
/** Page d'un article (français et anglais). Le texte vient du fichier Markdown de l'article. */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import { getContent } from '../data';
import { articleSlug, formatDate, getArticles, readingTime, type Article } from '../data/articles';
import { articlePath, getLang, otherLang, path } from '../i18n';
import { url } from '../utils/url';

interface Props {
  article: Article;
}
const { article } = Astro.props;
const lang = getLang(Astro.currentLocale);
const { site } = getContent(lang);
const { Content, headings } = await render(article);
// Sommaire : les intertitres principaux de l'article
const toc = headings.filter((h) => h.depth === 2);
// Typographie française : espace insécable fine avant « : ; ! ? » » et après « « » (uniquement dans le texte, pas dans les balises)
const typo = (html: string) =>
  html.replace(/>([^<]+)</g, (_, text: string) => `>${text.replace(/ ([:;!?»])/g, '\u202F$1').replace(/« /g, '«\u202F')}<`);
// Les schémas et graphiques SVG (<div data-inline-svg="/images/…svg">) sont insérés directement dans la page :
// leurs textes restent lisibles par les lecteurs d'écran et prennent la police du site.
const inlineSvg = (html: string) =>
  html.replace(/<div data-inline-svg="([^"]+)"><\/div>/g, (_, src: string) => {
    try {
      const svg = readFileSync(join(process.cwd(), 'public', src), 'utf8').replace(/<\?xml[^>]*>\s*/, '');
      return `<div class="svg-inline">${svg}</div>`;
    } catch {
      return `<img src="${url(src)}" alt="" />`;
    }
  });
const html = article.rendered?.html ? inlineSvg(lang === 'fr' ? typo(article.rendered.html) : article.rendered.html) : null;
const { title, description, date, author, authorRole, authorImage, authorLink, kicker, image, imageAlt, tags, translation, draft } = article.data;
const { fondatrice } = getContent(lang);
// Encadré « À propos de l'autrice » : renseigné automatiquement quand authorLink vaut « founder »
const authorBox =
  authorLink === 'founder'
    ? { photo: '/images/fondatrice-640.webp', bio: fondatrice.teaser, href: path('founder', lang) }
    : authorImage
      ? { photo: authorImage, bio: authorRole ?? '', href: authorLink }
      : null;
const slug = articleSlug(article);
// Identifiant de l'article pour les compteurs et les commentaires (ex. « fr/mon-article »)
const statsKey = `${lang}/${slug}`;

// Version dans l'autre langue (si le champ « translation » pointe vers un article existant)
const other = otherLang(lang);
const translated = translation ? (await getArticles(other)).find((a) => articleSlug(a) === translation) : undefined;
const slugs = { [lang]: slug, ...(translated ? { [other]: translation } : {}) };

const related = (await getArticles(lang)).filter((a) => a.id !== article.id).slice(0, 3);
const pageUrl = new URL(articlePath(slug, lang), Astro.site).href;
const share = encodeURIComponent(pageUrl);
const shareText = encodeURIComponent(`${title} — ${pageUrl}`);

const T = {
  fr: {
    breadcrumb: 'Fil d’Ariane',
    articles: 'Articles',
    by: 'Par',
    about: 'À propos de l’autrice',
    profile: 'Découvrir son parcours',
    min: 'min de lecture',
    draft: 'Brouillon : cet article n’est pas publié',
    share: 'Partager l’article',
    copy: 'Copier le lien',
    copied: 'Lien copié !',
    related: 'À lire aussi',
    back: 'Tous les articles',
    ctaTitle: 'Envie d’agir à nos côtés ?',
    ctaText: 'Bénévolat, partenariat, don : chaque pas compte.',
    cta: 'S’engager',
    views: 'vues',
    view: 'vue',
    reads: 'lectures complètes',
    read: 'lecture complète',
    comments: 'Commentaires',
    commentsIntro: 'Réagissez à cet article. Votre commentaire sera publié après relecture par l’équipe.',
    noComments: 'Aucun commentaire pour l’instant : soyez la première ou le premier à réagir.',
    name: 'Votre nom ou prénom',
    email: 'Votre e-mail (facultatif, jamais publié)',
    message: 'Votre commentaire',
    send: 'Envoyer le commentaire',
    sending: 'Envoi…',
    thanks: 'Merci ! Votre commentaire a bien été reçu. Il apparaîtra ici après relecture par l’équipe.',
    error: 'L’envoi n’a pas abouti. Vérifiez les champs et réessayez dans un instant.',
    rate: 'Vous avez envoyé plusieurs commentaires en peu de temps. Réessayez dans quelques minutes.',
    replyFrom: 'Réponse de HATUA Foundation',
    pending: 'En attente de relecture : visible seulement par vous pour l’instant',
    like: 'J’aime',
    likeAria: 'J’aime ce commentaire',
    thumb: 'Pouce',
    thumbAria: 'Pouce levé pour ce commentaire',
    reply: 'Répondre',
    replyTo: 'Réponse à',
    replyAria: 'Répondre à',
    replies: 'réponses',
    oneReply: 'réponse',
    sendReply: 'Envoyer la réponse',
    cancel: 'Annuler',
    shareComment: 'Partager',
    shareAria: 'Partager le commentaire de',
    linkCopied: 'Lien copié !',
    replyThanks: 'Merci ! Votre réponse a bien été reçue. Elle apparaîtra après relecture par l’équipe.',
    more: 'Voir plus',
    less: 'Voir moins',
    toc: 'Sommaire',
    parts: 'parties',
    progress: 'Progression de la lecture',
    commentsLabel: 'commentaires',
    commentLabel: 'commentaire',
    privacy: 'Votre nom et votre commentaire seront visibles par tous. N’indiquez pas d’informations personnelles sur un enfant.',
    honeypot: 'Ne pas remplir ce champ',
  },
  en: {
    breadcrumb: 'Breadcrumb',
    articles: 'Articles',
    by: 'By',
    about: 'About the author',
    profile: 'Read her story',
    min: 'min read',
    draft: 'Draft: this article is not published',
    share: 'Share this article',
    copy: 'Copy link',
    copied: 'Link copied!',
    related: 'Read also',
    back: 'All articles',
    ctaTitle: 'Would you like to act with us?',
    ctaText: 'Volunteering, partnership, donation: every step counts.',
    cta: 'Get involved',
    views: 'views',
    view: 'view',
    reads: 'full reads',
    read: 'full read',
    comments: 'Comments',
    commentsIntro: 'Share your thoughts on this article. Your comment will be published after review by our team.',
    noComments: 'No comments yet: be the first to respond.',
    name: 'Your name or first name',
    email: 'Your email (optional, never published)',
    message: 'Your comment',
    send: 'Post comment',
    sending: 'Sending…',
    thanks: 'Thank you! Your comment has been received. It will appear here once our team has reviewed it.',
    error: 'Sending failed. Please check the fields and try again in a moment.',
    rate: 'You have posted several comments in a short time. Please try again in a few minutes.',
    replyFrom: 'Reply from HATUA Foundation',
    pending: 'Awaiting review: only visible to you for now',
    like: 'Like',
    likeAria: 'Like this comment',
    thumb: 'Thumbs up',
    thumbAria: 'Thumbs up for this comment',
    reply: 'Reply',
    replyTo: 'Reply to',
    replyAria: 'Reply to',
    replies: 'replies',
    oneReply: 'reply',
    sendReply: 'Post reply',
    cancel: 'Cancel',
    shareComment: 'Share',
    shareAria: 'Share the comment by',
    linkCopied: 'Link copied!',
    replyThanks: 'Thank you! Your reply has been received. It will appear once our team has reviewed it.',
    more: 'See more',
    less: 'See less',
    toc: 'Contents',
    parts: 'sections',
    progress: 'Reading progress',
    commentsLabel: 'comments',
    commentLabel: 'comment',
    privacy: 'Your name and comment will be visible to everyone. Do not share personal information about a child.',
    honeypot: 'Leave this field empty',
  },
}[lang];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: lang,
  author: { '@type': author === site.nameAlt || author === site.name ? 'Organization' : 'Person', name: author, ...(authorBox?.href ? { url: new URL(authorBox.href, Astro.site).href } : {}) },
  publisher: { '@type': 'NGO', name: site.nameAlt, logo: { '@type': 'ImageObject', url: new URL(url('/icon-512.png'), Astro.site).href } },
  mainEntityOfPage: pageUrl,
  ...(image ? { image: new URL(url(image), Astro.site).href } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={image}
  imageAlt={imageAlt}
  noindex={draft}
  structuredData={articleLd}
  page={{ key: 'article', slugs }}
>
  <!-- Barre de progression de la lecture -->
  <div class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-1" aria-hidden="true">
    <div class="h-full origin-left scale-x-0 bg-linear-to-r from-hibiscus via-secondary to-primary transition-transform duration-150" data-reading-progress></div>
  </div>

  <article>
    <header class="tone-ivoire relative overflow-hidden">
      <span class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-hibiscus/15 blur-3xl" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -bottom-32 -left-20 h-80 w-80 rounded-full bg-accent/40 blur-3xl" aria-hidden="true"></span>
      <div class="relative container-site max-w-4xl pt-10 pb-10 sm:pt-16">
        <nav aria-label={T.breadcrumb} class="text-sm text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={path('articles', lang)} class="inline-flex items-center gap-1.5 hover:text-secondary hover:underline"><Icon name="arrow-left" size={14} /> {T.articles}</a></li>
          </ol>
        </nav>
        {draft && <p class="mt-6 rounded-xl bg-secondary px-4 py-2 text-sm font-semibold text-white">{T.draft}</p>}
        {tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2 text-xs font-semibold">
            {tags.map((tag, i) => <li class:list={['rounded-full px-3 py-1', ['bg-primary-50 text-primary', 'bg-secondary-50 text-secondary', 'bg-accent/70 text-encre'][i % 3]]}>{tag}</li>)}
          </ul>
        )}
        {kicker && <p class="eyebrow mt-6">{kicker}</p>}
        <h1 class="mt-3 text-[2.15rem] leading-[1.1] font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl">{title}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-muted sm:text-xl">{description}</p>
        <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-3 text-sm text-muted">
          <span class="inline-flex items-center gap-3">
            {authorImage && <img src={url(authorImage)} alt="" width="48" height="48" class="h-12 w-12 rounded-full object-cover ring-2 ring-hibiscus/60" />}
            <span>
              {T.by} <strong class="font-semibold text-ink">{author}</strong>
              {authorRole && <span class="block text-xs">{authorRole}</span>}
            </span>
          </span>
          <span class="flex flex-wrap items-center gap-2">
            <time datetime={date.toISOString()} class="inline-flex items-center gap-1.5 rounded-full bg-white/80 px-3 py-1 ring-1 ring-sand"><Icon name="calendar" size={14} /> {formatDate(date, lang)}</time>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-50 px-3 py-1 font-semibold text-primary"><Icon name="clock" size={14} /> {readingTime(article)} {T.min}</span>
            <!-- Compteurs : affichés seulement si le service répond -->
            <span class="hidden items-center gap-1.5 rounded-full bg-accent/60 px-3 py-1 font-semibold text-encre" data-stat="views"><Icon name="eye" size={14} /> <span data-n></span></span>
            <span class="hidden items-center gap-1.5 rounded-full bg-white/80 px-3 py-1 ring-1 ring-sand" data-stat="reads"><Icon name="book" size={14} /> <span data-n></span></span>
            <a href="#commentaires" class="hidden items-center gap-1.5 rounded-full bg-secondary-50 px-3 py-1 font-semibold text-secondary transition hover:bg-secondary hover:text-white" data-stat="comments"><Icon name="message" size={14} /> <span data-n></span></a>
          </span>
        </div>
      </div>
    </header>

    {
      image && (
        <figure class="tone-ivoire">
          <div class="container-site max-w-5xl pb-4">
            <img src={url(image)} alt={imageAlt ?? ''} width="1600" height="900" fetchpriority="high" class="aspect-[16/9] w-full rounded-3xl object-cover shadow-xl ring-1 ring-sand" />
          </div>
        </figure>
      )
    }

    <div class="tone-blanc">
      <div class="container-site max-w-3xl py-12 sm:py-16">
        {
          toc.length > 2 && (
            <details class="toc group/toc mb-10 rounded-2xl bg-cream ring-1 ring-sand open:shadow-sm">
              <summary class="flex cursor-pointer list-none items-center gap-3 px-5 py-4 font-display font-semibold text-secondary">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-secondary text-white"><Icon name="list" size={18} /></span>
                <span class="flex-1">{T.toc} <span class="font-normal text-muted">· {toc.length} {T.parts}</span></span>
                <Icon name="chevron-down" size={20} class="transition-transform group-open/toc:rotate-180" />
              </summary>
              <ol class="grid gap-1 px-5 pb-5">
                {toc.map((h, i) => (
                  <li>
                    <a href={`#${h.slug}`} class="flex gap-3 rounded-xl px-3 py-2 transition hover:bg-white" data-toc-link={h.slug}>
                      <span class="w-6 shrink-0 font-display font-bold text-hibiscus tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                      <span class="text-ink">{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
        <div class="prose-article">
          {html ? <Fragment set:html={html} /> : <Content />}
        </div>

        {
          authorBox && (
            <aside class="card mt-14 flex flex-col gap-6 sm:flex-row sm:items-center" aria-labelledby="a-propos-auteur">
              <img src={url(authorBox.photo)} alt={author} width="160" height="168" loading="lazy" class="h-36 w-36 shrink-0 rounded-2xl object-cover object-top sm:h-40 sm:w-40" />
              <div>
                <p id="a-propos-auteur" class="eyebrow">{T.about}</p>
                <p class="mt-2 font-display text-xl font-bold text-secondary">{author}</p>
                {authorBox.bio && <p class="mt-2 leading-relaxed text-muted">{authorBox.bio}</p>}
                {authorBox.href && (
                  <a href={authorBox.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary hover:underline">
                    {T.profile} <Icon name="arrow-right" size={16} />
                  </a>
                )}
              </div>
            </aside>
          )
        }

        <!-- Repère de fin de lecture : atteint = « lecture complète » -->
        <div data-read-end aria-hidden="true"></div>

        <!-- Partage -->
        <div class="mt-14 border-t border-sand pt-8">
          <p class="font-display font-semibold text-secondary">{T.share}</p>
          <ul class="mt-4 flex flex-wrap gap-2.5">
            <li><a href={`https://wa.me/?text=${shareText}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" title="WhatsApp" class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary-50 text-primary transition hover:bg-primary hover:text-white"><Icon name="whatsapp" size={20} /></a></li>
            <li><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn" class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary-50 text-primary transition hover:bg-primary hover:text-white"><Icon name="linkedin" size={20} /></a></li>
            <li><a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook" class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary-50 text-primary transition hover:bg-primary hover:text-white"><Icon name="facebook" size={20} /></a></li>
            <li>
              <button type="button" data-copy-link={pageUrl} data-copied={T.copied} class="inline-flex h-11 items-center gap-2 rounded-full bg-primary-50 px-4 text-sm font-semibold text-primary transition hover:bg-primary hover:text-white">
                <Icon name="link" size={18} /> <span data-copy-label>{T.copy}</span>
              </button>
            </li>
          </ul>
        </div>

        <!-- Commentaires (publiés après validation dans ÉCHOS) -->
        <section id="commentaires" class="mt-14 border-t border-sand pt-8" aria-labelledby="titre-commentaires" data-comments={statsKey}
          data-l-view={T.view} data-l-views={T.views} data-l-read={T.read} data-l-reads={T.reads}
          data-l-thanks={T.thanks} data-l-error={T.error} data-l-rate={T.rate} data-l-reply={T.replyFrom} data-l-pending={T.pending} data-l-like={T.like} data-l-like-aria={T.likeAria} data-l-sending={T.sending} data-l-send={T.send} data-lang={lang}
          data-l-thumb={T.thumb} data-l-thumb-aria={T.thumbAria} data-l-reply-btn={T.reply} data-l-reply-to={T.replyTo} data-l-reply-aria={T.replyAria}
          data-l-replies={T.replies} data-l-one-reply={T.oneReply} data-l-share={T.shareComment} data-l-share-aria={T.shareAria} data-l-copied={T.linkCopied}
          data-l-reply-thanks={T.replyThanks} data-url={pageUrl} data-l-more={T.more} data-l-less={T.less}
          data-l-comment={T.commentLabel} data-l-comments={T.commentsLabel}>
          <h2 id="titre-commentaires" class="font-display text-2xl font-bold">{T.comments} <span class="text-muted" data-comment-count></span></h2>
          <p class="mt-2 text-muted">{T.commentsIntro}</p>
          <ol class="mt-6 grid gap-5" data-comment-list></ol>
          <p class="sr-only" aria-live="polite" data-live></p>
          <template data-reply-template>
            <form class="mt-4 grid gap-3 rounded-2xl border-2 border-accent bg-cream p-4" novalidate>
              <p class="flex flex-wrap items-center gap-2 text-sm font-semibold text-secondary">{T.replyTo} <span class="rounded-full bg-secondary px-2.5 py-0.5 text-white" data-reply-who></span></p>
              <div class="grid gap-3 sm:grid-cols-2">
                <div>
                  <label class="mb-1 block text-sm font-semibold" data-for="name">{T.name} <span class="text-secondary" aria-hidden="true">*</span></label>
                  <input name="name" type="text" required minlength="2" maxlength="60" autocomplete="name" class="w-full rounded-xl border border-sand bg-white px-4 py-2.5" />
                </div>
                <div>
                  <label class="mb-1 block text-sm font-semibold" data-for="email">{T.email}</label>
                  <input name="email" type="email" maxlength="150" autocomplete="email" class="w-full rounded-xl border border-sand bg-white px-4 py-2.5" />
                </div>
              </div>
              <div>
                <label class="mb-1 block text-sm font-semibold" data-for="message">{T.message} <span class="text-secondary" aria-hidden="true">*</span></label>
                <textarea name="message" required minlength="3" maxlength="2000" rows="3" class="w-full rounded-xl border border-sand bg-white px-4 py-2.5"></textarea>
              </div>
              <p class="hidden" aria-hidden="true"><label>{T.honeypot} <input name="website" tabindex="-1" autocomplete="off" /></label></p>
              <div class="flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">{T.sendReply} <Icon name="send" size={18} /></button>
                <button type="button" class="btn btn-outline" data-reply-cancel>{T.cancel}</button>
              </div>
              <p class="hidden rounded-xl bg-secondary-50 p-3 font-medium text-secondary-dark" role="status" tabindex="-1" data-reply-status></p>
            </form>
          </template>
          <p class="mt-4 hidden text-muted" data-no-comments>{T.noComments}</p>

          <form class="card mt-8 grid gap-4" data-comment-form novalidate>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="c-name" class="mb-1.5 block text-sm font-semibold">{T.name} <span class="text-secondary" aria-hidden="true">*</span></label>
                <input id="c-name" name="name" type="text" required minlength="2" maxlength="60" autocomplete="name" class="w-full rounded-xl border border-sand bg-white px-4 py-3" />
              </div>
              <div>
                <label for="c-email" class="mb-1.5 block text-sm font-semibold">{T.email}</label>
                <input id="c-email" name="email" type="email" maxlength="150" autocomplete="email" class="w-full rounded-xl border border-sand bg-white px-4 py-3" />
              </div>
            </div>
            <div>
              <label for="c-message" class="mb-1.5 block text-sm font-semibold">{T.message} <span class="text-secondary" aria-hidden="true">*</span></label>
              <textarea id="c-message" name="message" required minlength="3" maxlength="2000" rows="5" class="w-full rounded-xl border border-sand bg-white px-4 py-3"></textarea>
            </div>
            <p class="hidden" aria-hidden="true"><label>{T.honeypot} <input name="website" tabindex="-1" autocomplete="off" /></label></p>
            <p class="text-sm text-muted">{T.privacy}</p>
            <div><button type="submit" class="btn btn-primary">{T.send} <Icon name="send" size={18} /></button></div>
            <p class="hidden rounded-xl p-4 font-medium" role="status" aria-live="polite" tabindex="-1" data-comment-status></p>
          </form>
        </section>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section tone-ivoire" aria-labelledby="a-lire-aussi">
        <div class="container-site">
          <h2 id="a-lire-aussi" class="text-3xl font-bold">{T.related}</h2>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((a) => <li><ArticleCard article={a} /></li>)}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section tone-terre">
    <div class="container-site flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{T.ctaTitle}</h2>
        <p class="mt-2 text-muted">{T.ctaText}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={path('engage', lang)} class="btn btn-primary">{T.cta} <Icon name="arrow-right" size={18} /></a>
        <a href={path('articles', lang)} class="btn btn-outline">{T.back}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // --- Vues, lectures complètes et commentaires (module PHP /api, sur Hostinger)
  const box = document.querySelector<HTMLElement>('[data-comments]');
  if (box) {
    const key = box.dataset.comments!;
    const L = box.dataset;
    const fmt = new Intl.NumberFormat(L.lang === 'en' ? 'en-GB' : 'fr-FR');
    const plural = (n: number, one: string, many: string) => `${fmt.format(n)} ${n > 1 ? many : one}`;
    const show = (name: string, text: string) => {
      const el = document.querySelector<HTMLElement>(`[data-stat="${name}"]`);
      if (!el) return;
      el.querySelector('[data-n]')!.textContent = text;
      el.classList.remove('hidden');
      el.classList.add('inline-flex');
    };
    const post = (url: string, body: object) =>
      fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

    // 1. Une vue (comptée une fois par jour et par personne côté serveur)
    post('/api/stats.php', { slug: key, type: 'view' })
      .catch(() => undefined)
      .then(() => fetch(`/api/stats.php?slugs=${encodeURIComponent(key)}`))
      .then((r) => (r && r.ok ? r.json() : null))
      .then((d) => {
        const s = d?.[key];
        if (!s) return;
        show('views', plural(s.views, L.lView!, L.lViews!));
        if (s.reads > 0) show('reads', plural(s.reads, L.lRead!, L.lReads!));
        show('comments', plural(s.comments, L.lComment!, L.lComments!));
      })
      .catch(() => undefined);

    // 2. Une lecture complète : la fin de l'article est atteinte après au moins 30 secondes sur la page
    const end = document.querySelector('[data-read-end]');
    const start = Date.now();
    if (end && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting) && Date.now() - start > 30000) {
          io.disconnect();
          post('/api/stats.php', { slug: key, type: 'read' }).catch(() => undefined);
        }
      });
      io.observe(end);
    }

    // 3. Commentaires validés (avec leurs réponses) + ceux de ce visiteur encore en attente (gardés sur son appareil)
    type C = {
      id?: number; name: string; message: string; reply?: string | null; created_at: string; pending?: boolean;
      likes?: number; thumbs?: number; parent_id?: number | null; reply_to?: string | null;
    };
    const store = {
      get<T>(k: string, fallback: T): T {
        try {
          return JSON.parse(localStorage.getItem(k) ?? 'null') ?? fallback;
        } catch {
          return fallback;
        }
      },
      set(k: string, v: unknown) {
        try {
          localStorage.setItem(k, JSON.stringify(v));
        } catch {
          /* stockage indisponible */
        }
      },
    };
    // Réactions déjà données depuis cet appareil (le serveur, lui, compte une fois par personne)
    const reacted = {
      love: new Set<number>(store.get<number[]>('hatua-liked-comments', [])),
      thumb: new Set<number>(store.get<number[]>('hatua-thumbed-comments', [])),
    };
    const saveReacted = () => {
      store.set('hatua-liked-comments', [...reacted.love].slice(-500));
      store.set('hatua-thumbed-comments', [...reacted.thumb].slice(-500));
    };
    const svg = (d: string, fill = false) =>
      `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="${fill ? 'currentColor' : 'none'}" stroke="${fill ? 'none' : 'currentColor'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
    const ICON = {
      love: svg('<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>', true),
      thumb: svg('<path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>'),
      reply: svg('<path d="M9 17 4 12l5-5"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/>'),
      share: svg('<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"/>'),
    };
    // Une couleur par personne (toujours la même pour un même nom)
    const PALETTE = [
      { av: 'bg-secondary text-white', edge: 'border-l-secondary' },
      { av: 'bg-primary text-white', edge: 'border-l-primary' },
      { av: 'bg-hibiscus text-encre', edge: 'border-l-hibiscus' },
      { av: 'bg-accent text-encre', edge: 'border-l-accent' },
      { av: 'bg-primary-light text-white', edge: 'border-l-primary-light' },
    ];
    const colorOf = (name: string) => PALETTE[[...name.toLowerCase()].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 7) % PALETTE.length];
    const initials = (name: string) => (name.match(/\p{L}[\p{L}'’-]*/gu) ?? ['?']).slice(0, 2).map((w) => w[0].toUpperCase()).join('');
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    };
    const live = box.querySelector<HTMLElement>('[data-live]')!;
    const announce = (msg: string) => {
      live.textContent = '';
      setTimeout(() => (live.textContent = msg), 50);
    };

    const list = box.querySelector<HTMLOListElement>('[data-comment-list]')!;
    const dateFmt = new Intl.DateTimeFormat(L.lang === 'en' ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    const mineKey = `hatua-comments:${key}`;
    const loadMine = (): C[] => store.get<C[]>(mineKey, []);
    const saveMine = (items: C[]) => store.set(mineKey, items.slice(-20));

    // Bouton « pouce » ou « j'aime »
    const reactButton = (c: C, kind: 'love' | 'thumb') => {
      const btn = el('button');
      btn.type = 'button';
      let count = (kind === 'love' ? c.likes : c.thumbs) ?? 0;
      const paint = () => {
        const on = reacted[kind].has(c.id!);
        const styles = kind === 'love'
          ? (on ? 'bg-hibiscus text-encre' : 'bg-secondary-50 text-secondary hover:bg-hibiscus hover:text-encre')
          : (on ? 'bg-primary text-white' : 'bg-primary-50 text-primary hover:bg-primary hover:text-white');
        btn.className = `inline-flex min-h-9 items-center gap-1.5 rounded-full px-2.5 sm:px-3 text-sm font-semibold transition active:scale-95 ${styles}`;
        btn.setAttribute('aria-pressed', String(on));
        btn.setAttribute('aria-label', `${kind === 'love' ? L.lLikeAria : L.lThumbAria} (${count})`);
        btn.innerHTML = `${ICON[kind]}<span class="hidden sm:inline">${kind === 'love' ? L.lLike : L.lThumb}</span>${count ? `<span aria-hidden="true" class="tabular-nums">${count}</span>` : ''}`;
      };
      paint();
      btn.addEventListener('click', async () => {
        const undo = reacted[kind].has(c.id!);
        btn.disabled = true;
        try {
          const r = await post('/api/comments.php', { like: c.id, kind, unlike: undo });
          if (!r.ok) return;
          count = (await r.json()).count ?? count;
          if (undo) reacted[kind].delete(c.id!);
          else reacted[kind].add(c.id!);
          saveReacted();
          paint();
        } finally {
          btn.disabled = false;
        }
      });
      return btn;
    };

    // Partager un commentaire précis (lien direct vers lui)
    const shareButton = (c: C) => {
      const btn = el('button', 'inline-flex min-h-9 items-center gap-1.5 rounded-full bg-sand px-2.5 sm:px-3 text-sm font-semibold text-ink transition hover:bg-secondary hover:text-white active:scale-95');
      btn.type = 'button';
      btn.setAttribute('aria-label', `${L.lShareAria} ${c.name}`);
      btn.innerHTML = `${ICON.share}<span class="hidden sm:inline" data-label>${L.lShare}</span>`;
      btn.addEventListener('click', async () => {
        const link = `${L.url}#comment-${c.id}`;
        const excerpt = c.message.length > 120 ? `${c.message.slice(0, 117)}…` : c.message;
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title, text: `${c.name} : « ${excerpt} »`, url: link });
            return;
          } catch (e) {
            if ((e as DOMException)?.name === 'AbortError') return;
          }
        }
        try {
          await navigator.clipboard.writeText(link);
          const label = btn.querySelector<HTMLElement>('[data-label]')!;
          label.classList.remove('hidden');
          label.textContent = L.lCopied!;
          announce(L.lCopied!);
          setTimeout(() => {
            label.textContent = L.lShare!;
            label.classList.add('hidden');
          }, 2000);
        } catch {
          location.hash = `comment-${c.id}`;
        }
      });
      return btn;
    };

    // Formulaire de réponse (un seul ouvert à la fois, sous le commentaire visé)
    const tpl = box.querySelector<HTMLTemplateElement>('[data-reply-template]')!;
    let openForm: HTMLFormElement | null = null;
    const openReply = (target: C, host: HTMLElement, trigger: HTMLButtonElement) => {
      openForm?.remove();
      const form = (tpl.content.firstElementChild as HTMLFormElement).cloneNode(true) as HTMLFormElement;
      form.querySelectorAll<HTMLLabelElement>('label[data-for]').forEach((lab) => {
        const field = form.querySelector<HTMLElement>(`[name="${lab.dataset.for}"]`)!;
        field.id = `r-${target.id}-${lab.dataset.for}`;
        lab.htmlFor = field.id;
      });
      form.querySelector('[data-reply-who]')!.textContent = `@${target.name}`;
      const nameInput = form.querySelector<HTMLInputElement>('[name="name"]')!;
      nameInput.value = store.get<string>('hatua-comment-name', '');
      const statusBox = form.querySelector<HTMLElement>('[data-reply-status]')!;
      const opened = Date.now();
      const close = () => {
        form.remove();
        openForm = null;
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      };
      form.querySelector('[data-reply-cancel]')!.addEventListener('click', close);
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        const f = new FormData(form);
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        btn.disabled = true;
        try {
          const r = await post('/api/comments.php', {
            slug: key, parent: target.id, name: f.get('name'), email: f.get('email'), message: f.get('message'),
            website: f.get('website'), elapsed: Math.round((Date.now() - opened) / 1000),
          });
          if (r.status === 429) throw new Error(L.lRate);
          if (!r.ok) throw new Error(L.lError);
          const res = await r.json().catch(() => ({}));
          store.set('hatua-comment-name', String(f.get('name')));
          saveMine([...loadMine(), {
            id: res.id, name: String(f.get('name')), message: String(f.get('message')), created_at: new Date().toISOString(),
            parent_id: res.parent_id ?? target.parent_id ?? target.id, reply_to: res.reply_to ?? target.name,
          }]);
          openForm = null;
          showAll(approvedCache);
          announce(L.lReplyThanks!);
        } catch (err) {
          statusBox.textContent = (err as Error).message || L.lError!;
          statusBox.classList.remove('hidden');
          statusBox.focus();
        } finally {
          btn.disabled = false;
        }
      });
      host.append(form);
      openForm = form;
      trigger.setAttribute('aria-expanded', 'true');
      (nameInput.value ? form.querySelector<HTMLTextAreaElement>('textarea')! : nameInput).focus();
    };

    // Carte d'un commentaire ou d'une réponse (textContent uniquement : aucun HTML venant des visiteurs n'est interprété)
    const render = (c: C, isReply: boolean) => {
      const tone = colorOf(c.name);
      const li = el('li', isReply
        ? `rounded-2xl bg-cream p-3 sm:p-4 ${c.pending ? 'border-2 border-dashed border-hibiscus' : ''}`
        : `rounded-2xl border-l-4 bg-white p-5 shadow-sm ring-1 ring-sand ${c.pending ? 'border-dashed !border-l-hibiscus' : tone.edge}`);
      if (c.id && !c.pending) li.id = `comment-${c.id}`;
      li.classList.add('scroll-mt-28', 'transition-shadow');

      const head = el('div', 'flex items-start gap-3');
      const avatar = el('span', `inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-bold ${tone.av}`, initials(c.name));
      avatar.setAttribute('aria-hidden', 'true');
      const meta = el('div', 'min-w-0');
      const line = el('p', 'text-sm text-muted');
      line.append(el('strong', 'font-semibold text-ink', c.name), ` · ${dateFmt.format(new Date(c.created_at))}`);
      if (c.pending) line.append(el('span', 'mt-1 block w-fit rounded-full bg-accent px-3 py-0.5 text-xs font-semibold text-encre sm:ml-2 sm:mt-0 sm:inline-block', L.lPending!));
      meta.append(line);
      // Long commentaire : 5 lignes, puis « Voir plus » (ajouté après l'affichage si le texte dépasse)
      const body = el('p', 'mt-1.5 line-clamp-5 whitespace-pre-line break-words');
      body.dataset.clamp = '';
      if (c.reply_to) {
        const tag = el('span', 'mr-1.5 rounded-full bg-secondary-50 px-2 py-0.5 text-sm font-semibold text-secondary', `@${c.reply_to}`);
        tag.setAttribute('title', `${L.lReplyTo} ${c.reply_to}`);
        body.append(tag);
      }
      body.append(c.message);
      meta.append(body);
      head.append(avatar, meta);
      li.append(head);

      if (!c.pending && c.id) {
        const bar = el('div', 'mt-3 flex flex-wrap gap-1.5 sm:gap-2 sm:pl-13');
        const replyBtn = el('button', 'inline-flex min-h-9 items-center gap-1.5 rounded-full bg-accent/60 px-2.5 sm:px-3 text-sm font-semibold text-encre transition hover:bg-accent active:scale-95');
        replyBtn.type = 'button';
        replyBtn.setAttribute('aria-expanded', 'false');
        replyBtn.setAttribute('aria-label', `${L.lReplyAria} ${c.name}`);
        replyBtn.innerHTML = `${ICON.reply}<span>${L.lReplyBtn}</span>`;
        replyBtn.addEventListener('click', () => (openForm && replyBtn.getAttribute('aria-expanded') === 'true' ? (openForm.remove(), (openForm = null), replyBtn.setAttribute('aria-expanded', 'false')) : openReply(c, li, replyBtn)));
        bar.append(reactButton(c, 'thumb'), reactButton(c, 'love'), replyBtn, shareButton(c));
        li.append(bar);
      }
      if (c.reply) {
        const rep = el('div', 'mt-4 rounded-xl border-l-4 border-primary bg-primary-50 p-4');
        const rb = el('p', 'mt-1 line-clamp-5 whitespace-pre-line break-words', c.reply);
        rb.dataset.clamp = '';
        rep.append(el('p', 'text-sm font-semibold text-primary', L.lReply!), rb);
        li.append(rep);
      }
      return li;
    };

    const addSeeMore = (root: HTMLElement) => {
      root.querySelectorAll<HTMLElement>('[data-clamp]').forEach((p) => {
        if (p.scrollHeight <= p.clientHeight + 2 || p.nextElementSibling?.hasAttribute('data-see-more')) return;
        const more = el('button', 'mt-1 inline-flex items-center gap-1 rounded-full text-sm font-semibold text-secondary underline-offset-2 hover:underline', L.lMore);
        more.type = 'button';
        more.dataset.seeMore = '';
        more.setAttribute('aria-expanded', 'false');
        more.addEventListener('click', () => {
          const open = p.classList.toggle('line-clamp-5') === false;
          more.textContent = open ? L.lLess! : L.lMore!;
          more.setAttribute('aria-expanded', String(open));
        });
        p.after(more);
      });
    };

    const showAll = (approved: C[]) => {
      const ids = new Set(approved.map((c) => c.id));
      // Un commentaire publié n'est plus « en attente » : on l'oublie sur l'appareil
      const month = Date.now() - 30 * 86400000;
      const mine = loadMine().filter((c) => !ids.has(c.id) && new Date(c.created_at).getTime() > month).map((m) => ({ ...m, pending: true }));
      saveMine(mine);
      const all = [...approved, ...mine];
      const tops = all.filter((c) => !c.parent_id);
      const repliesOf = (id?: number) => all.filter((c) => c.parent_id && c.parent_id === id);
      list.replaceChildren();
      box.querySelector('[data-comment-count]')!.textContent = approved.length ? `(${approved.length})` : '';
      box.querySelector('[data-no-comments]')!.classList.toggle('hidden', all.length > 0);
      for (const c of tops) {
        const li = render(c, false);
        const replies = repliesOf(c.id);
        if (replies.length) {
          li.append(el('p', 'mt-4 text-xs font-semibold tracking-wide text-secondary uppercase', `${replies.length} ${replies.length > 1 ? L.lReplies : L.lOneReply}`));
          const ol = el('ol', 'mt-2 grid gap-3 border-l-2 border-dashed border-hibiscus/60 pl-2 sm:ml-5 sm:pl-5');
          replies.forEach((r) => ol.append(render(r, true)));
          li.append(ol);
        }
        list.append(li);
      }
      addSeeMore(list);
    };

    // Lien direct vers un commentaire (#comment-12) : on le montre et on le fait ressortir
    const highlight = () => {
      const target = location.hash.startsWith('#comment-') ? document.getElementById(location.hash.slice(1)) : null;
      if (!target) return;
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('ring-4', 'ring-accent');
      setTimeout(() => target.classList.remove('ring-4', 'ring-accent'), 4000);
    };
    window.addEventListener('hashchange', highlight);

    let approvedCache: C[] = [];
    fetch(`/api/comments.php?slug=${encodeURIComponent(key)}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        approvedCache = d?.comments ?? [];
        showAll(approvedCache);
        highlight();
      })
      .catch(() => showAll([]));

    // 4. Envoi d'un commentaire
    const form = box.querySelector<HTMLFormElement>('[data-comment-form]')!;
    const status = form.querySelector<HTMLElement>('[data-comment-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const opened = Date.now();
    const say = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.classList.remove('hidden', 'bg-primary-50', 'text-primary-dark', 'bg-secondary-50', 'text-secondary-dark');
      status.classList.add(...(ok ? ['bg-primary-50', 'text-primary-dark'] : ['bg-secondary-50', 'text-secondary-dark']));
      status.focus();
    };
    const mainName = form.querySelector<HTMLInputElement>('[name="name"]')!;
    if (!mainName.value) mainName.value = store.get<string>('hatua-comment-name', '');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const f = new FormData(form);
      button.disabled = true;
      try {
        const r = await post('/api/comments.php', {
          slug: key,
          name: f.get('name'),
          email: f.get('email'),
          message: f.get('message'),
          website: f.get('website'),
          elapsed: Math.round((Date.now() - opened) / 1000),
        });
        if (r.status === 429) return say(L.lRate!, false);
        if (!r.ok) throw new Error(String(r.status));
        const res = await r.json().catch(() => ({}));
        store.set('hatua-comment-name', String(f.get('name')));
        saveMine([...loadMine(), { id: res.id, name: String(f.get('name')), message: String(f.get('message')), created_at: new Date().toISOString() }]);
        showAll(approvedCache);
        form.reset();
        mainName.value = String(f.get('name'));
        say(L.lThanks!, true);
      } catch {
        say(L.lError!, false);
      } finally {
        button.disabled = false;
      }
    });
  }

  // Barre de progression de la lecture (jusqu'à la fin du texte de l'article)
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const prose = document.querySelector<HTMLElement>('.prose-article');
  if (bar && prose) {
    let ticking = false;
    const update = () => {
      const r = prose.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const done = Math.min(1, Math.max(0, -r.top / Math.max(total, 1)));
      bar.style.transform = `scaleX(${done})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyLink ?? location.href);
        const label = btn.querySelector('[data-copy-label]');
        if (label) {
          const before = label.textContent;
          label.textContent = btn.dataset.copied ?? '';
          setTimeout(() => (label.textContent = before), 2000);
        }
      } catch {
        /* presse-papiers indisponible : rien à faire */
      }
    });
  });
</script>
