---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { getContent, mailto } from '../data';
import { getLang, path, quote } from '../i18n';
import { url } from '../utils/url';

interface Props {
  slug: string;
}
const lang = getLang(Astro.currentLocale);
const { projects, poles } = getContent(lang);
const project = projects.find((p) => p.slug === Astro.props.slug)!;
const pole = poles.find((p) => p.id === project.pole);

const T = {
  fr: {
    breadcrumb: 'Fil d’Ariane',
    projects: 'Projets',
    support: 'Soutenir le projet',
    timeline: 'Voir le calendrier',
    contextEyebrow: 'Contexte',
    contextTitle: 'Des voix qui résonnent',
    objectivesEyebrow: 'Objectifs',
    objectivesTitle: 'Ce que le projet veut rendre possible',
    timelineEyebrow: 'Calendrier',
    timelineTitle: 'Le chemin, étape par étape',
    joinEyebrow: 'Rejoindre le projet',
    joinTitle: 'Faisons ce pas ensemble',
    write: 'Nous écrire',
  },
  en: {
    breadcrumb: 'Breadcrumb',
    projects: 'Projects',
    support: 'Support the project',
    timeline: 'See the timeline',
    contextEyebrow: 'Context',
    contextTitle: 'Voices that echo',
    objectivesEyebrow: 'Objectives',
    objectivesTitle: 'What the project aims to make possible',
    timelineEyebrow: 'Timeline',
    timelineTitle: 'The path, step by step',
    joinEyebrow: 'Join the project',
    joinTitle: 'Let’s take this step together',
    write: 'Write to us',
  },
}[lang];
const colon = lang === 'fr' ? ' : ' : ': ';
---

<BaseLayout
  title={`${project.title}${colon}${project.tagline}`}
  description={project.summary}
  type="article"
  page={{ key: 'project', slug: project.slug }}
>
  <!-- En-tête du projet -->
  <section class="relative overflow-hidden bg-primary-dark text-white">
    <svg class="pointer-events-none absolute right-0 bottom-0 h-full w-auto text-white/[0.05]" viewBox="0 0 400 300" aria-hidden="true">
      <path fill="currentColor" d="M0 300v-60h100v-60h100v-60h100V60h100v240z" />
    </svg>
    <div class="container-site relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <nav aria-label={T.breadcrumb} class="text-sm text-white/75">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={path('projects', lang)} class="inline-flex items-center gap-1.5 hover:text-white hover:underline"><Icon name="arrow-left" size={14} /> {T.projects}</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{project.title}</li>
          </ol>
        </nav>
        <div class="mt-6 flex flex-wrap gap-2 text-xs font-semibold">
          {pole && <span class="rounded-full bg-white/10 px-3 py-1">{pole.englishName}</span>}
          <span class="rounded-full bg-accent px-3 py-1 text-primary-dark">{project.status}</span>
        </div>
        <h1 class="mt-5 text-5xl font-bold !text-white sm:text-6xl">{project.title}</h1>
        <p class="mt-3 font-display text-2xl font-medium text-accent-soft sm:text-3xl">{quote(project.tagline, lang)}</p>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">{project.summary}</p>
        <p class="mt-6 flex items-center gap-2 text-white/85">
          <Icon name="map-pin" size={18} class="text-accent-soft" /> {project.location}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#partenariat" class="btn btn-primary">{T.support} <Icon name="arrow-right" size={18} /></a>
          <a href="#calendrier" class="btn btn-outline-light">{T.timeline}</a>
        </div>
      </div>
      <img
        src={url(project.image.src)}
        srcset={project.image.srcSmall ? `${url(project.image.srcSmall)} 800w, ${url(project.image.src)} 1536w` : undefined}
        sizes="(min-width: 1024px) 45vw, 100vw"
        alt={project.image.alt}
        width="1536"
        height="1024"
        fetchpriority="high"
        class="aspect-[3/2] w-full rounded-3xl object-cover shadow-2xl"
      />
    </div>
  </section>

  <!-- Contexte -->
  <section class="section tone-ivoire" aria-labelledby="contexte">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <SectionTitle number="01" eyebrow={T.contextEyebrow} title={T.contextTitle} id="contexte" />
      <div class="reveal prose-hatua text-lg leading-relaxed">
        {project.context.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Objectifs -->
  <section class="section tone-miel" aria-labelledby="objectifs">
    <div class="container-site">
      <SectionTitle number="02" eyebrow={T.objectivesEyebrow} title={T.objectivesTitle} id="objectifs" />
      <ol class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          project.objectives.map((o, i) => (
            <li class={`card reveal reveal-delay-${(i % 2) + 1} flex gap-4`}>
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary-50 font-display text-sm font-bold text-secondary-dark">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="pt-1.5 text-lg leading-relaxed">{o}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Calendrier -->
  <section id="calendrier" class="section tone-ivoire scroll-mt-20" aria-labelledby="calendrier-titre">
    <div class="container-site">
      <SectionTitle number="03" eyebrow={T.timelineEyebrow} title={T.timelineTitle} id="calendrier-titre" />
      <div class="mt-12">
        <Timeline steps={project.timeline} />
      </div>
    </div>
  </section>

  <!-- Appel à partenariat -->
  <section id="partenariat" class="section tone-terre scroll-mt-20" aria-labelledby="partenariat-titre">
    <div class="container-site">
      <SectionTitle number="04" eyebrow={T.joinEyebrow} title={T.joinTitle} intro={project.callIntro} id="partenariat-titre" />
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          project.calls.map((c, i) => (
            <li class={`card reveal reveal-delay-${i + 1} flex flex-col`}>
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-50 text-primary">
                <Icon name={c.icon} />
              </span>
              <h3 class="mt-5 text-xl font-semibold">{c.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-muted">{c.text}</p>
              <a href={mailto(c.subject)} class="mt-5 inline-flex items-center gap-1.5 font-semibold text-secondary hover:underline">
                {T.write} <span class="sr-only">({c.title})</span> <Icon name="mail" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
