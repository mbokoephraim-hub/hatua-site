---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import EngageForm from '../components/EngageForm.astro';
import VolunteerForm from '../components/VolunteerForm.astro';
import { getContent } from '../data';
import { getLang, path } from '../i18n';
import { url } from '../utils/url';

interface Props {
  /** Page dédiée (bénévolat, partenariat ou don) ; sans valeur : page de choix « S'engager » */
  part?: 'benevolat' | 'partenariat' | 'don';
}
const { part } = Astro.props;
const lang = getLang(Astro.currentLocale);
const { engage, images, site, forms: engageForms } = getContent(lang);
// Champ « type d'organisation » du formulaire de partenariat (prérempli depuis les cartes)
const orgTypeField = engageForms.partenariat.fields.find((f) => f.options?.includes(engage.partners.types[0].formType))!.name;

const T = {
  fr: {
    title: 'S’engager',
    description: `Bénévolat, partenariat, don : découvrez comment soutenir ${site.name}.`,
    headerTitle: 'Et si le prochain pas, c’était le vôtre ?',
    ways: 'Façons de s’engager',
    volunteering: 'Bénévolat',
    partnerships: 'Partenariats',
    donate: 'Faire un don',
    welcome: 'Nous accueillons notamment :',
    how: 'Comment ça se passe ?',
    apply: 'Proposer ma candidature',
    propose: 'Proposer un partenariat',
    donEyebrow: 'Don',
    donForm: 'Remplir le formulaire de don',
    choose: 'Choisissez votre façon de vous engager',
    open: 'Ouvrir',
    allWays: 'Toutes les façons de s’engager',
    others: 'Les autres façons de s’engager',
    cards: {
      don: { title: 'Faire un don', text: 'Soutenez nos projets et leur déploiement, par un don financier ou matériel.', hint: ['Ponctuel ou régulier', 'Mobile Money, virement…'] },
      benevolat: { title: 'Devenir bénévole', text: 'Donnez de votre temps et de vos compétences aux côtés de l’équipe.', hint: ['Formation offerte', 'Programmes du samedi'] },
      partenariat: { title: 'Devenir partenaire', text: 'Écoles, entreprises, institutions : construisons ensemble des actions durables.', hint: ['Accueillir ÉCHOS', 'Soutien, mécénat'] },
    },
    heads: {
      don: { title: 'Faire un don', intro: 'Chaque contribution permet à un jeune de faire un pas de plus. Indiquez-nous comment vous souhaitez aider.' },
      benevolat: { title: 'Devenir bénévole', intro: 'Rejoignez celles et ceux qui rendent chaque pas possible : cinq petites étapes pour candidater.' },
      partenariat: { title: 'Devenir partenaire', intro: 'Écoles, entreprises, institutions : construisons ensemble des actions à fort impact.' },
    },
  },
  en: {
    title: 'Get involved',
    description: `Volunteering, partnership, donation: find out how to support ${site.name}.`,
    headerTitle: 'What if the next step were yours?',
    ways: 'Ways to get involved',
    volunteering: 'Volunteering',
    partnerships: 'Partnerships',
    donate: 'Make a donation',
    welcome: 'We especially welcome:',
    how: 'How does it work?',
    apply: 'Apply',
    propose: 'Propose a partnership',
    donEyebrow: 'Donation',
    donForm: 'Fill in the donation form',
    choose: 'Choose how you want to get involved',
    open: 'Open',
    allWays: 'All the ways to get involved',
    others: 'Other ways to get involved',
    cards: {
      don: { title: 'Make a donation', text: 'Support our projects and their roll-out, with a financial or in-kind gift.', hint: ['One-off or regular', 'Mobile Money, transfer…'] },
      benevolat: { title: 'Become a volunteer', text: 'Give your time and skills alongside the team.', hint: ['Training provided', 'Saturday programmes'] },
      partenariat: { title: 'Become a partner', text: 'Schools, companies, institutions: let’s build lasting actions together.', hint: ['Host ÉCHOS', 'Support, sponsorship'] },
    },
    heads: {
      don: { title: 'Make a donation', intro: 'Every contribution helps a young person take one more step. Tell us how you would like to help.' },
      benevolat: { title: 'Become a volunteer', intro: 'Join those who make every step possible: five short steps to apply.' },
      partenariat: { title: 'Become a partner', intro: 'Schools, companies, institutions: let’s build high-impact actions together.' },
    },
  },
}[lang];

const { volunteer, partners, donate } = engage;
const pageKeys = { benevolat: 'engageVolunteer', partenariat: 'engagePartner', don: 'engageDonate' } as const;
const cards = (['don', 'benevolat', 'partenariat'] as const).map((k) => ({
  key: k, ...T.cards[k], href: path(pageKeys[k], lang),
  icon: { don: 'gift', benevolat: 'user-plus', partenariat: 'handshake' }[k],
  tone: { don: 'grad-miel', benevolat: 'grad-baobab', partenariat: 'grad-terre' }[k],
}));
const head = part ? T.heads[part] : null;
---

<BaseLayout title={head ? head.title : T.title} description={head ? head.intro : T.description} page={{ key: part ? pageKeys[part] : 'engage' }}>
  <PageHeader tone="terre" eyebrow={T.title} title={head ? head.title : T.headerTitle} intro={head ? head.intro : engage.intro}>
    {part && <a href={path('engage', lang)} class="engage-back"><Icon name="arrow-left" size={16} /> {T.allWays}</a>}
  </PageHeader>

  {
    !part && (
      <section class="section tone-ivoire" aria-labelledby="choix-titre">
        <div class="container-site">
          <h2 id="choix-titre" class="reveal text-center text-2xl font-bold sm:text-3xl">{T.choose}</h2>
          <ul class="engage-choices mt-10">
            {cards.map((c, i) => (
              <li class={`reveal reveal-delay-${i + 1}`}>
                <a href={c.href} class={`engage-choice ${c.tone}`}>
                  <span class="ec-blob" aria-hidden="true" />
                  <span class="ec-icon"><Icon name={c.icon} size={30} /></span>
                  <span class="ec-title">{c.title}</span>
                  <span class="ec-text">{c.text}</span>
                  <span class="ec-hints">{c.hint.map((h) => <span>{h}</span>)}</span>
                  <span class="ec-go">{T.open} <Icon name="arrow-right" size={18} /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Bénévolat -->
  {part === 'benevolat' && (
  <section id="benevolat" class="section tone-ivoire scroll-mt-20" aria-labelledby="benevolat-titre">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionTitle eyebrow={T.volunteering} title={volunteer.title} intro={volunteer.text} id="benevolat-titre" />
        <h3 class="reveal mt-8 text-lg font-semibold">{T.welcome}</h3>
        <ul class="reveal mt-4 flex flex-wrap gap-2">
          {volunteer.profiles.map((p) => <li class="rounded-full bg-primary-50 px-4 py-2 text-sm font-medium text-primary-dark">{p}</li>)}
        </ul>
        <img
          src={url(images.engage.src)}
          srcset={`${url(images.engage.srcSmall)} 640w, ${url(images.engage.src)} 1200w`}
          sizes="(min-width: 1024px) 45vw, 100vw"
          alt={images.engage.alt}
          width={images.engage.width}
          height={images.engage.height}
          loading="lazy"
          class="reveal mt-10 aspect-[4/3] w-full rounded-3xl object-cover object-[center_8%]"
        />
      </div>
      <div class="lg:pt-24">
        <div class="card reveal !p-7 sm:!p-9">
          <h3 class="text-xl font-semibold">{T.how}</h3>
          <ol class="mt-6 space-y-6">
            {
              volunteer.steps.map((s, i) => (
                <li class="relative flex gap-4">
                  {i < volunteer.steps.length - 1 && <span class="absolute top-11 bottom-[-1.25rem] left-5 w-0.5 bg-sand" aria-hidden="true" />}
                  <span class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary font-display text-sm font-bold text-white">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <p class="font-display font-semibold text-primary-dark">{s.title}</p>
                    <p class="mt-1 leading-relaxed text-muted">{s.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <a href="#formulaire-benevolat" class="btn btn-green mt-8 w-full sm:w-auto">
            <Icon name="user-plus" size={18} /> {T.apply}
          </a>
        </div>
      </div>
    </div>
    <div class="container-site reveal mt-14">
      <VolunteerForm />
    </div>
  </section>

  )}

  <!-- Partenariats -->
  {part === 'partenariat' && (
  <section id="partenariats" class="section tone-baobab scroll-mt-20" aria-labelledby="partenariats-titre">
    <div class="container-site">
      <SectionTitle eyebrow={T.partnerships} title={partners.title} intro={partners.text} id="partenariats-titre" />
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          partners.types.map((p, i) => (
            <li class={`card reveal reveal-delay-${i + 1} flex flex-col`}>
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-white">
                <Icon name={p.icon} />
              </span>
              <h3 class="mt-5 text-xl font-semibold">{p.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-muted">{p.text}</p>
              <a
                href="#formulaire-partenariat"
                data-prefill-field={orgTypeField}
                data-prefill-value={p.formType}
                class="mt-5 inline-flex items-center gap-1.5 font-semibold text-secondary hover:underline"
              >
                {T.propose} <span class="sr-only">({p.title})</span> <Icon name="arrow-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="reveal mt-10">
        <EngageForm form={engageForms.partenariat} />
      </div>
    </div>
  </section>

  )}

  <!-- Don -->
  {part === 'don' && (
  <section id="don" class="section tone-ivoire scroll-mt-20" aria-labelledby="don-titre">
    <div class="container-site">
      <div class="tone-miel reveal relative overflow-hidden rounded-[2rem] px-6 py-12 sm:px-12 sm:py-16">
        <svg class="pointer-events-none absolute right-0 bottom-0 h-full w-auto text-secondary/10" viewBox="0 0 400 300" aria-hidden="true">
          <path fill="currentColor" d="M0 300v-60h100v-60h100v-60h100V60h100v240z" />
        </svg>
        <div class="relative max-w-2xl">
          <p class="eyebrow">
            <span class="step-line" aria-hidden="true"><span></span><span></span><span></span></span>
            {T.donEyebrow}
          </p>
          <h2 id="don-titre" class="mt-4 text-3xl font-bold sm:text-4xl">{donate.title}</h2>
          <p class="mt-4 text-lg leading-relaxed">{donate.text}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#formulaire-don" class="btn btn-primary">
              <Icon name="gift" size={18} /> {T.donForm}
            </a>
            <a href={site.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              <Icon name="whatsapp" size={18} /> WhatsApp
            </a>
          </div>
        </div>
      </div>
      <div class="reveal mt-10">
        <EngageForm form={engageForms.don} />
      </div>
    </div>
  </section>
  )}

  {
    part && (
      <section class="section tone-blanc" aria-labelledby="autres-titre">
        <div class="container-site">
          <h2 id="autres-titre" class="text-2xl font-bold">{T.others}</h2>
          <ul class="engage-choices engage-others mt-6">
            {cards.filter((c) => c.key !== part).map((c) => (
              <li>
                <a href={c.href} class={`engage-choice ${c.tone}`}>
                  <span class="ec-icon"><Icon name={c.icon} size={24} /></span>
                  <span class="ec-title">{c.title}</span>
                  <span class="ec-go">{T.open} <Icon name="arrow-right" size={18} /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
