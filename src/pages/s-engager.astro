---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import EngageForm from '../components/EngageForm.astro';
import { engageForms } from '../data/forms';
import { engage } from '../data/engage';
import { images } from '../data/images';
import { site } from '../data/site';
import { url } from '../utils/url';

const { volunteer, partners, donate } = engage;
---

<BaseLayout title="S’engager" description={`Bénévolat, partenariat, don : découvrez comment soutenir ${site.name}.`}>
  <PageHeader tone="terre" eyebrow="S’engager" title="Et si le prochain pas, c’était le vôtre ?" intro={engage.intro}>
    <nav aria-label="Façons de s’engager" class="mt-8 flex flex-wrap gap-3">
      <a href="#benevolat" class="btn btn-green">Bénévolat</a>
      <a href="#partenariats" class="btn btn-outline">Partenariats</a>
      <a href="#don" class="btn btn-outline">Faire un don</a>
    </nav>
  </PageHeader>

  <!-- Bénévolat -->
  <section id="benevolat" class="section tone-ivoire scroll-mt-20" aria-labelledby="benevolat-titre">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionTitle number="01" eyebrow="Bénévolat" title={volunteer.title} intro={volunteer.text} id="benevolat-titre" />
        <h3 class="reveal mt-8 text-lg font-semibold">Nous accueillons notamment :</h3>
        <ul class="reveal mt-4 flex flex-wrap gap-2">
          {volunteer.profiles.map((p) => <li class="rounded-full bg-primary-50 px-4 py-2 text-sm font-medium text-primary-dark">{p}</li>)}
        </ul>
        <img
          src={url(images.engage.src)}
          srcset={`${url(images.engage.srcSmall)} 640w, ${url(images.engage.src)} 1200w`}
          sizes="(min-width: 1024px) 45vw, 100vw"
          alt={images.engage.alt}
          width={images.engage.width}
          height={images.engage.height}
          loading="lazy"
          class="reveal mt-10 aspect-[4/3] w-full rounded-3xl object-cover object-[center_15%]"
        />
      </div>
      <div class="lg:pt-24">
        <div class="card reveal !p-7 sm:!p-9">
          <h3 class="text-xl font-semibold">Comment ça se passe ?</h3>
          <ol class="mt-6 space-y-6">
            {
              volunteer.steps.map((s, i) => (
                <li class="relative flex gap-4">
                  {i < volunteer.steps.length - 1 && <span class="absolute top-11 bottom-[-1.25rem] left-5 w-0.5 bg-sand" aria-hidden="true" />}
                  <span class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary font-display text-sm font-bold text-white">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <p class="font-display font-semibold text-primary-dark">{s.title}</p>
                    <p class="mt-1 leading-relaxed text-muted">{s.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <a href="#formulaire-benevolat" class="btn btn-green mt-8 w-full sm:w-auto">
            <Icon name="user-plus" size={18} /> Proposer ma candidature
          </a>
        </div>
      </div>
    </div>
    <div class="container-site reveal mt-14">
      <EngageForm form={engageForms.benevolat} />
    </div>
  </section>

  <!-- Partenariats -->
  <section id="partenariats" class="section tone-baobab scroll-mt-20" aria-labelledby="partenariats-titre">
    <div class="container-site">
      <SectionTitle number="02" eyebrow="Partenariats" title={partners.title} intro={partners.text} id="partenariats-titre" />
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          partners.types.map((p, i) => (
            <li class={`card reveal reveal-delay-${i + 1} flex flex-col`}>
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-white">
                <Icon name={p.icon} />
              </span>
              <h3 class="mt-5 text-xl font-semibold">{p.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-muted">{p.text}</p>
              <a
                href="#formulaire-partenariat"
                data-prefill-field="Type d’organisation"
                data-prefill-value={p.formType}
                class="mt-5 inline-flex items-center gap-1.5 font-semibold text-secondary hover:underline"
              >
                Proposer un partenariat <span class="sr-only">({p.title})</span> <Icon name="arrow-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="reveal mt-10">
        <EngageForm form={engageForms.partenariat} />
      </div>
    </div>
  </section>

  <!-- Don -->
  <section id="don" class="section tone-ivoire scroll-mt-20" aria-labelledby="don-titre">
    <div class="container-site">
      <div class="tone-miel reveal relative overflow-hidden rounded-[2rem] px-6 py-12 sm:px-12 sm:py-16">
        <svg class="pointer-events-none absolute right-0 bottom-0 h-full w-auto text-secondary/10" viewBox="0 0 400 300" aria-hidden="true">
          <path fill="currentColor" d="M0 300v-60h100v-60h100v-60h100V60h100v240z" />
        </svg>
        <div class="relative max-w-2xl">
          <p class="eyebrow">
            <span class="step-line" aria-hidden="true"><span></span><span></span><span></span></span>
            03 · Don
          </p>
          <h2 id="don-titre" class="mt-4 text-3xl font-bold sm:text-4xl">{donate.title}</h2>
          <p class="mt-4 text-lg leading-relaxed">{donate.text}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#formulaire-don" class="btn btn-primary">
              <Icon name="gift" size={18} /> Remplir le formulaire de don
            </a>
            <a href={site.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              <Icon name="whatsapp" size={18} /> WhatsApp
            </a>
          </div>
        </div>
      </div>
      <div class="reveal mt-10">
        <EngageForm form={engageForms.don} />
      </div>
    </div>
  </section>
</BaseLayout>
