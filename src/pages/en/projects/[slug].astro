---
import type { GetStaticPaths } from 'astro';
import Project from '../../../views/Project.astro';
import { projects } from '../../../data/en/projects';

export const getStaticPaths = (() => projects.map((p) => ({ params: { slug: p.slug } }))) satisfies GetStaticPaths;
---

<Project slug={Astro.params.slug!} />
