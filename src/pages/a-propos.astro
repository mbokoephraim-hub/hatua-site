---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { values } from '../data/values';
import { images } from '../data/images';
import { url } from '../utils/url';
---

<BaseLayout title="À propos" description={`Découvrez ${site.name} : le sens de son nom, sa mission, sa vision et ses valeurs.`}>
  <PageHeader
    eyebrow="À propos"
    title="Avancer, un pas après l’autre"
    intro={`${site.name} est une ${site.status.toLowerCase()} basée à ${site.location.city}, fondée par ${site.founder}.`}
  />

  <!-- Histoire et sens du nom -->
  <section class="section" aria-labelledby="histoire">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionTitle number="01" eyebrow="Notre nom" title="Hatua : le pas, l’étape" id="histoire" />
        <div class="reveal prose-hatua mt-6 text-lg leading-relaxed text-ink">
          <p>
            En {site.nameMeaning.language}, <strong class="text-primary">{site.nameMeaning.word.toLowerCase()}</strong> veut dire
            « {site.nameMeaning.meaning} ». Ce mot résume notre manière de voir le changement : il ne se décrète pas, il se construit.
          </p>
          <p>
            Un jeune qui ose poser une question, une femme qui suit sa première formation, une communauté qui se réunit pour
            chercher des solutions : chacun de ces pas compte. Notre rôle est de les rendre possibles.
          </p>
        </div>
        <div class="placeholder-note reveal mt-8">
          <p class="font-semibold">[À REMPLACER] Notre histoire</p>
          <p class="mt-2 text-sm leading-relaxed">
            Racontez ici la naissance de la fondation : l’année de création, ce qui a poussé {site.founder} à la fonder, les
            premières personnes engagées et les premières étapes franchies.
          </p>
        </div>
      </div>
      <figure class="reveal">
        <img src={url(images.about.src)} alt={images.about.alt} width="1200" height="800" loading="lazy" class="aspect-[3/2] w-full rounded-3xl object-cover shadow-lg" />
      </figure>
    </div>
  </section>

  <!-- Mission & vision -->
  <section class="section bg-white" aria-labelledby="mission">
    <div class="container-site grid gap-6 lg:grid-cols-2">
      <article class="reveal relative overflow-hidden rounded-3xl bg-primary p-8 text-white sm:p-10">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent text-primary-dark"><Icon name="target" /></span>
        <h2 id="mission" class="mt-6 text-3xl font-bold !text-white">Notre mission</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/90">{site.mission}</p>
      </article>
      <article class="reveal reveal-delay-1 relative overflow-hidden rounded-3xl border border-sand bg-cream p-8 sm:p-10">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-secondary text-white"><Icon name="compass" /></span>
        <h2 class="mt-6 text-3xl font-bold">Notre vision</h2>
        <div class="prose-hatua mt-4 text-lg leading-relaxed text-ink">
          {site.vision.map((p) => <p>{p}</p>)}
        </div>
      </article>
    </div>
  </section>

  <!-- Valeurs -->
  <section class="section" aria-labelledby="valeurs">
    <div class="container-site">
      <SectionTitle
        number="02"
        eyebrow="Nos valeurs"
        title="Ce qui guide chacun de nos pas"
        intro="Cinq repères pour agir avec justesse, aux côtés des jeunes et des communautés."
        id="valeurs"
      />
      <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {
          values.map((v, i) => (
            <li class={`card reveal reveal-delay-${(i % 3) + 1} relative`}>
              <span class="font-display text-sm font-bold text-secondary">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 text-xl font-semibold">{v.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Mot de la fondatrice -->
  <section class="section bg-white" aria-labelledby="fondatrice">
    <div class="container-site">
      <div class="reveal mx-auto max-w-3xl">
        <SectionTitle number="03" eyebrow="Le mot de la fondatrice" title={site.founder} id="fondatrice" />
        <figure class="relative mt-8 overflow-hidden rounded-3xl bg-cream p-8 ring-1 ring-sand sm:p-12">
          <span class="pointer-events-none absolute top-4 left-6 font-display text-[6rem] leading-[0.8] text-accent select-none" aria-hidden="true">“</span>
          <blockquote class="relative mt-10 space-y-5 font-display text-lg leading-relaxed text-ink sm:text-xl">
            {site.founderMessage.map((p, i) => <p class:list={[i === site.founderMessage.length - 1 && 'font-semibold text-secondary']}>{p}</p>)}
          </blockquote>
          <figcaption class="relative mt-8 flex items-center gap-4">
            <span class="step-line text-secondary" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>
              <span class="block font-display font-semibold text-secondary">{site.founder}</span>
              <span class="block text-sm text-muted">Fondatrice de {site.name}</span>
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section pt-0 bg-white">
    <div class="container-site flex flex-wrap justify-center gap-3">
      <a href={url('/poles')} class="btn btn-green">Découvrir nos pôles <Icon name="arrow-right" size={18} /></a>
      <a href={url('/s-engager')} class="btn btn-outline">S’engager avec nous</a>
    </div>
  </section>
</BaseLayout>
