---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { path } from '../i18n';
---

<BaseLayout title="Page introuvable" noindex>
  <section class="section">
    <div class="container-site max-w-2xl text-center">
      <svg class="mx-auto h-28 w-auto" viewBox="0 0 220 120" aria-hidden="true">
        <rect x="10" y="80" width="50" height="30" rx="6" fill="var(--color-primary-50)" />
        <rect x="70" y="55" width="50" height="55" rx="6" fill="var(--color-accent-soft)" />
        <rect x="130" y="30" width="50" height="80" rx="6" fill="var(--color-secondary)" />
        <path d="M190 30h22" stroke="var(--color-muted)" stroke-width="3" stroke-dasharray="3 6" stroke-linecap="round" />
      </svg>
      <p class="mt-8 font-display text-sm font-bold tracking-[0.2em] text-secondary uppercase">Erreur 404</p>
      <h1 class="mt-3 text-4xl font-bold sm:text-5xl">Ce pas ne mène nulle part…</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        La page que vous cherchez n’existe pas ou a été déplacée. Pas d’inquiétude : on reprend le chemin ensemble.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={path('home', 'fr')} class="btn btn-green"><Icon name="arrow-left" size={18} /> Retour à l’accueil</a>
        <a href={path('contact', 'fr')} class="btn btn-outline">Nous contacter</a>
      </div>

      <!-- Version anglaise : une seule page 404 sert tout le site -->
      <div lang="en" class="mt-12 border-t border-sand pt-8">
        <p class="font-display text-lg font-semibold text-secondary">This step leads nowhere…</p>
        <p class="mt-2 text-muted">The page you are looking for does not exist or has been moved.</p>
        <a href={path('home', 'en')} class="mt-4 inline-flex items-center gap-1.5 font-semibold text-link hover:underline">
          <Icon name="arrow-left" size={16} /> Back to the English home page
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
