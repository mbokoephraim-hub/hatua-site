---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../utils/url';
---

<BaseLayout title="Page introuvable" noindex>
  <section class="section">
    <div class="container-site max-w-2xl text-center">
      <svg class="mx-auto h-28 w-auto" viewBox="0 0 220 120" aria-hidden="true">
        <rect x="10" y="80" width="50" height="30" rx="6" fill="var(--color-primary-50)" />
        <rect x="70" y="55" width="50" height="55" rx="6" fill="var(--color-accent-soft)" />
        <rect x="130" y="30" width="50" height="80" rx="6" fill="var(--color-secondary)" />
        <path d="M190 30h22" stroke="var(--color-muted)" stroke-width="3" stroke-dasharray="3 6" stroke-linecap="round" />
      </svg>
      <p class="mt-8 font-display text-sm font-bold tracking-[0.2em] text-secondary uppercase">Erreur 404</p>
      <h1 class="mt-3 text-4xl font-bold sm:text-5xl">Ce pas ne mène nulle part…</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        La page que vous cherchez n’existe pas ou a été déplacée. Pas d’inquiétude : on reprend le chemin ensemble.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={url('/')} class="btn btn-green"><Icon name="arrow-left" size={18} /> Retour à l’accueil</a>
        <a href={url('/contact')} class="btn btn-outline">Nous contacter</a>
      </div>
    </div>
  </section>
</BaseLayout>
