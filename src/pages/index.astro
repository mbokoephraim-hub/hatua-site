---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSteps from '../components/HeroSteps.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PoleCard from '../components/PoleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EngageBanner from '../components/EngageBanner.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { fondatrice } from '../data/fondatrice';
import { poles } from '../data/poles';
import { projects } from '../data/projects';
import { t } from '../i18n/ui';
import { url } from '../utils/url';

const featured = projects[0];
---

<BaseLayout>
  <!-- HERO -->
  <section class="tone-ivoire relative overflow-hidden">
    <div class="pointer-events-none absolute -top-40 -right-40 h-[32rem] w-[32rem] rounded-full bg-primary-50 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:py-24">
      <div>
        <p class="eyebrow">
          <span class="step-line" aria-hidden="true"><span></span><span></span><span></span></span>
          {site.location.city}, {site.location.countryShort}
        </p>
        <h1 class="mt-5 text-5xl leading-[1.05] font-bold sm:text-6xl lg:text-7xl">
          {site.nameAlt.split(' ')[0]}<br />
          <span class="text-secondary">Foundation</span>
        </h1>
        <p class="mt-5 font-display text-2xl font-semibold text-primary sm:text-3xl">{site.slogan}</p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{site.shortMission}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={url('/poles')} class="btn btn-green">{t('cta.discover')} <Icon name="arrow-right" size={18} /></a>
          <a href={url('/s-engager#don')} class="btn btn-outline">{t('cta.support')}</a>
        </div>
      </div>
      <HeroSteps />
    </div>
  </section>

  <!-- À LA DÉCOUVERTE DE LA FONDATRICE -->
  <section class="tone-blanc py-12 sm:py-16" aria-labelledby="fondatrice-apercu">
    <div class="container-site reveal grid items-center gap-8 sm:grid-cols-[auto_1fr] sm:gap-12">
      <img
        src={url(fondatrice.photos.portrait.src)}
        alt={fondatrice.photos.portrait.alt}
        width="176"
        height="176"
        loading="lazy"
        class="mx-auto h-36 w-36 rounded-full object-cover object-[center_18%] ring-4 ring-accent ring-offset-4 ring-offset-white sm:h-44 sm:w-44"
      />
      <div class="text-center sm:text-left">
        <h2 id="fondatrice-apercu" class="text-2xl font-bold sm:text-3xl">À la découverte de la fondatrice</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted">{fondatrice.teaser}</p>
        <a href={url('/fondatrice')} class="btn btn-primary mt-6">
          Découvrir {fondatrice.name} <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- ÉTAPE APRÈS ÉTAPE -->
  <section class="section tone-terre" aria-labelledby="conviction">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <SectionTitle number="01" eyebrow="Notre conviction" title="Étape après étape" id="conviction">
        <p class="mt-5 text-muted">
          <em class="font-display font-semibold text-eyebrow not-italic">« {site.nameMeaning.word} »</em> signifie
          « {site.nameMeaning.meaning} » en {site.nameMeaning.language}. Un nom qui dit tout de notre façon d’agir.
        </p>
        <a href={url('/a-propos')} class="mt-6 inline-flex items-center gap-1.5 font-semibold text-link hover:underline">
          Qui sommes-nous <Icon name="arrow-right" size={18} />
        </a>
      </SectionTitle>

      <ol class="space-y-5">
        {
          site.vision.map((p, i) => (
            <li class={`reveal reveal-delay-${i + 1} flex gap-5`}>
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-eyebrow/60 font-display text-sm font-bold text-eyebrow">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="pt-1.5 text-lg leading-relaxed text-ink">{p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- PÔLES -->
  <section class="section tone-ivoire" aria-labelledby="poles-titre">
    <div class="container-site">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionTitle
          number="02"
          eyebrow="Nos pôles"
          title="Sept pôles pour avancer ensemble"
          intro={site.domainsSentence}
          id="poles-titre"
        />
        <a href={url('/poles')} class="btn btn-outline shrink-0 self-start md:self-auto">Tous les pôles</a>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {poles.map((pole, i) => <li><PoleCard pole={pole} index={i} /></li>)}
        <li class="reveal">
          <a href={url('/s-engager')} class="group flex h-full min-h-56 flex-col justify-between rounded-2xl bg-secondary p-6 text-white transition hover:-translate-y-1 hover:bg-secondary-dark">
            <span class="step-line" aria-hidden="true"><span class="!bg-white/50"></span><span class="!bg-white/75"></span><span class="!bg-white"></span></span>
            <span>
              <span class="block font-display text-xl font-semibold">Un pôle vous parle ?</span>
              <span class="mt-2 block text-white">Engagez-vous à nos côtés comme bénévole ou partenaire.</span>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold">S’engager <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" /></span>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- PROJET PHARE -->
  {
    featured && (
      <section class="section tone-miel" aria-labelledby="projet-phare">
        <div class="container-site">
          <SectionTitle number="03" eyebrow="Projet phare" title="Notre premier pas : ÉCHOS" id="projet-phare" />
          <div class="mt-10">
            <ProjectCard project={featured} />
          </div>
        </div>
      </section>
    )
  }

  <!-- ENGAGEZ-VOUS -->
  <EngageBanner />

  <!-- CONTACT -->
  <section class="section tone-ivoire" aria-labelledby="contact-apercu">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <SectionTitle
        number="04"
        eyebrow="Contact"
        title="Parlons de votre prochain pas"
        intro="Une question, une idée, une envie de collaborer ? Nous serons heureux d’échanger avec vous."
        id="contact-apercu"
      >
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={url('/contact')} class="btn btn-green">{t('cta.contact')} <Icon name="arrow-right" size={18} /></a>
          <a href={site.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            <Icon name="whatsapp" size={18} /> WhatsApp
          </a>
        </div>
      </SectionTitle>
      <div class="card reveal !p-7 sm:!p-9">
        <ul class="space-y-4">
          <li class="flex items-center gap-4">
            <Icon name="mail" class="shrink-0 text-primary" />
            <a href={`mailto:${site.contact.email}`} class="font-medium break-all hover:text-primary hover:underline">{site.contact.email}</a>
          </li>
          <li class="flex items-center gap-4">
            <Icon name="phone" class="shrink-0 text-primary" />
            <a href={site.contact.phoneHref} class="font-medium hover:text-primary hover:underline">{site.contact.phoneDisplay}</a>
          </li>
          <li class="flex items-center gap-4">
            <Icon name="map-pin" class="shrink-0 text-primary" />
            <span class="font-medium">{site.location.city}, {site.location.country}</span>
          </li>
        </ul>
        <hr class="my-6 border-sand" />
        <p class="font-display font-semibold text-primary-dark">{t('footer.follow')}</p>
        <div class="mt-3"><SocialLinks /></div>
      </div>
    </div>
  </section>
</BaseLayout>
