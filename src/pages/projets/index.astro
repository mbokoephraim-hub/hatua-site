---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
import { url } from '../../utils/url';
---

<BaseLayout title="Projets" description={`Les projets de ${site.name}, à commencer par ÉCHOS : « Qui influence mes choix ? ».`}>
  <PageHeader
    eyebrow="Projets"
    title="Nos projets"
    intro="Chaque projet est une étape concrète vers notre mission. Voici où nous en sommes aujourd’hui."
  />

  <section class="section" aria-label="Liste des projets">
    <div class="container-site">
      <h2 class="sr-only">Liste des projets</h2>
      <ul class="space-y-8">
        {projects.map((project) => <li><ProjectCard project={project} /></li>)}
      </ul>

      <div class="reveal mt-12 rounded-3xl border-2 border-dashed border-sand p-8 text-center sm:p-10">
        <p class="font-display text-xl font-semibold text-primary-dark">D’autres projets sont en préparation</p>
        <p class="mx-auto mt-2 max-w-xl text-muted">Vous avez une idée ou souhaitez porter un projet avec nous ? Parlons-en.</p>
        <a href={url('/contact')} class="btn btn-outline mt-6">Nous contacter <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
