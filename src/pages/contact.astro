---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactInfo from '../components/ContactInfo.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, socialLinks } from '../data/site';
---

<BaseLayout title="Contact" description={`Contactez ${site.name} par e-mail, téléphone ou WhatsApp.`}>
  <PageHeader
    tone="baobab"
    eyebrow="Contact"
    title="Écrivons la suite ensemble"
    intro="Une question, une proposition de partenariat, une envie de vous engager ? Écrivez-nous, nous vous répondrons dès que possible."
  />

  <section class="section tone-ivoire">
    <div class="container-site grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-14">
      <div class="reveal">
        <h2 class="text-2xl font-bold">Envoyer un message</h2>
        <div class="mt-6"><ContactForm /></div>
      </div>
      <aside class="reveal reveal-delay-1" aria-labelledby="coordonnees">
        <h2 id="coordonnees" class="text-2xl font-bold">Nos coordonnées</h2>
        <div class="mt-6"><ContactInfo /></div>
        {
          socialLinks.length > 0 && (
            <div class="mt-8">
              <h3 class="font-display font-semibold text-primary-dark">Réseaux sociaux</h3>
              <div class="mt-3"><SocialLinks withContact={false} /></div>
            </div>
          )
        }
      </aside>
    </div>
  </section>
</BaseLayout>
